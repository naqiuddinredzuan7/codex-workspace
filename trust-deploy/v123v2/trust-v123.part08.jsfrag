ut id="cc-annual" class="thr117-input" type="number" step="0.01"></label><label>Reimbursement<select id="cc-mode" class="thr117-select"><option value="payroll">Payroll</option><option value="manual">Manual</option></select></label><label class="thr117-check"><input id="cc-attach" type="checkbox"><span><b>Attachment required</b><small>Receipt/document reference required.</small></span></label></div><div class="thr117-callout"><b>Statutory treatment starts as Review.</b><div class="thr117-sub">Create the business policy first, then verify tax/EPF/SOCSO treatment from evidence using Review Treatment.</div></div><div class="thr117-modal-actions"><button class="thr117-btn" id="cc-cancel">Cancel</button><button class="thr117-btn primary" id="cc-save">Create Policy</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#cc-cancel').onclick=()=>modal.remove();modal.querySelector('#cc-save').onclick=async()=>{try{setLoading(true);await rpc('thr_create_claim_category_v120',{p_org_id:ORG_ID,p_code:modal.querySelector('#cc-code').value,p_label:modal.querySelector('#cc-label').value,p_description:null,p_per_claim_limit:modal.querySelector('#cc-per').value?Number(modal.querySelector('#cc-per').value):null,p_annual_limit:modal.querySelector('#cc-annual').value?Number(modal.querySelector('#cc-annual').value):null,p_requires_attachment:modal.querySelector('#cc-attach').checked,p_reimbursement_mode:modal.querySelector('#cc-mode').value,p_taxable:false,p_epf_included:false,p_socso_included:false,p_eis_included:false});modal.remove();await loadData(false);state.operationsSub='claims';render();toast('Claim policy created with statutory review required.');}catch(e){toast(e.message||'Unable to create category.');}finally{setLoading(false);}};}
function openClaimTreatmentModal(id){const c=arr(state.operationsBundle?.claim_categories).find(x=>x.id===id);if(!c)return;const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">CLAIM STATUTORY TREATMENT</div><h3>${esc(c.label)}</h3><label class="thr117-field-label">PCB treatment<select id="ct-pcb" class="thr117-select"><option value="review" ${c.pcb_treatment==='review'?'selected':''}>Review required</option><option value="normal" ${c.pcb_treatment==='normal'?'selected':''}>Normal remuneration</option><option value="additional" ${c.pcb_treatment==='additional'?'selected':''}>Additional remuneration</option><option value="non_taxable" ${c.pcb_treatment==='non_taxable'?'selected':''}>Non-taxable reimbursement</option></select></label><div class="thr117-form-grid"><label class="thr117-check"><input id="ct-tax" type="checkbox" ${c.taxable?'checked':''}><span><b>Taxable</b></span></label><label class="thr117-check"><input id="ct-epf" type="checkbox" ${c.epf_included?'checked':''}><span><b>EPF included</b></span></label><label class="thr117-check"><input id="ct-soc" type="checkbox" ${c.socso_included?'checked':''}><span><b>SOCSO / EIS included</b></span></label></div><label class="thr117-field-label">Authority / policy source reference<input id="ct-source" class="thr117-input" value="${esc(c.treatment_source_reference||'')}" placeholder="Official source / approved policy reference"></label><label class="thr117-check"><input id="ct-verified" type="checkbox" ${c.treatment_verified?'checked':''}><span><b>Treatment verified</b><small>Requires a source reference. TRUST will block payroll attachment otherwise.</small></span></label><div class="thr117-modal-actions"><button class="thr117-btn" id="ct-cancel">Cancel</button><button class="thr117-btn primary" id="ct-save">Save Treatment</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#ct-cancel').onclick=()=>modal.remove();modal.querySelector('#ct-save').onclick=async()=>{try{setLoading(true);const soc=modal.querySelector('#ct-soc').checked;await rpc('thr_set_claim_category_treatment_v121',{p_category_id:id,p_pcb_treatment:modal.querySelector('#ct-pcb').value,p_epf_included:modal.querySelector('#ct-epf').checked,p_socso_included:soc,p_eis_included:soc,p_taxable:modal.querySelector('#ct-tax').checked,p_source_reference:modal.querySelector('#ct-source').value||null,p_verified:modal.querySelector('#ct-verified').checked});modal.remove();await loadData(false);render();toast('Claim statutory treatment saved.');}catch(e){toast(e.message||'Treatment validation failed.');}finally{setLoading(false);}};}
function openNewClaimModal(){const cats=arr(state.operationsBundle?.claim_categories);if(!cats.length){toast('Create a claim category first.');return;}const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">CLAIMS</div><h3>Submit employee claim</h3><label class="thr117-field-label">Employee<select id="cl-emp" class="thr117-select">${employeeOptions()}</select></label><label class="thr117-field-label">Category<select id="cl-cat" class="thr117-select">${selectOptions(cats,'id',x=>x.label)}</select></label><div class="thr117-form-grid"><label>Claim date<input id="cl-date" class="thr117-input" type="date" value="${todayISO()}"></label><label>Receipt date<input id="cl-receipt" class="thr117-input" type="date" value="${todayISO()}"></label><label>Amount<input id="cl-amount" class="thr117-input" type="number" min="0.01" step="0.01"></label><label>Attachment reference<input id="cl-attachment" class="thr117-input" placeholder="Document/storage reference"></label><label>Cost centre<input id="cl-cost" class="thr117-input"></label><label>Project code<input id="cl-project" class="thr117-input"></label></div><label class="thr117-field-label">Description<textarea id="cl-desc" class="thr117-textarea" rows="3"></textarea></label><div class="thr117-modal-actions"><button class="thr117-btn" id="cl-cancel">Cancel</button><button class="thr117-btn primary" id="cl-save">Submit Claim</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#cl-cancel').onclick=()=>modal.remove();modal.querySelector('#cl-save').onclick=async()=>{try{setLoading(true);await rpc('thr_submit_claim_admin_v120',{p_org_id:ORG_ID,p_employee_id:modal.querySelector('#cl-emp').value,p_category_id:modal.querySelector('#cl-cat').value,p_claim_date:modal.querySelector('#cl-date').value,p_receipt_date:modal.querySelector('#cl-receipt').value||null,p_amount:Number(modal.querySelector('#cl-amount').value||0),p_currency:'MYR',p_description:modal.querySelector('#cl-desc').value||null,p_attachment_key:modal.querySelector('#cl-attachment').value||null,p_cost_center:modal.querySelector('#cl-cost').value||null,p_project_code:modal.querySelector('#cl-project').value||null});modal.remove();await loadData(false);render();toast('Claim submitted to approval inbox.');}catch(e){toast(e.message||'Unable to submit claim.');}finally{setLoading(false);}};}
function openProfileChangeModal(){const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">PROFILE CHANGE</div><h3>Propose employee data change</h3><label class="thr117-field-label">Employee<select id="pc-emp" class="thr117-select">${employeeOptions()}</select></label><div class="thr117-form-grid"><label>Phone<input id="pc-phone" class="thr117-input"></label><label>Email<input id="pc-email" class="thr117-input" type="email"></label><label>Payment method<select id="pc-payment" class="thr117-select"><option value="">No change</option><option value="bank">Bank</option><option value="cash">Cash</option></select></label><label>Bank name<input id="pc-bank" class="thr117-input"></label><label>Bank account no<input id="pc-acct" class="thr117-input"></label><label>Bank account name<input id="pc-acct-name" class="thr117-input"></label></div><label class="thr117-field-label">Reason<textarea id="pc-reason" class="thr117-textarea" rows="3"></textarea></label><div class="thr117-modal-actions"><button class="thr117-btn" id="pc-cancel">Cancel</button><button class="thr117-btn primary" id="pc-save">Submit for Approval</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#pc-cancel').onclick=()=>modal.remove();modal.querySelector('#pc-save').onclick=async()=>{const ch={};[['phone','#pc-phone'],['email','#pc-email'],['payment_method','#pc-payment'],['bank_name','#pc-bank'],['bank_account_no','#pc-acct'],['bank_account_name','#pc-acct-name']].forEach(([k,s])=>{const v=modal.querySelector(s).value.trim();if(v)ch[k]=v;});if(!Object.keys(ch).length){toast('Enter at least one requested change.');return;}try{setLoading(true);await rpc('thr_submit_profile_change_admin_v120',{p_org_id:ORG_ID,p_employee_id:modal.querySelector('#pc-emp').value,p_changes:ch,p_reason:modal.querySelector('#pc-reason').value||null});modal.remove();await loadData(false);render();toast('Profile change submitted for approval.');}catch(e){toast(e.message||'Unable to submit change.');}finally{setLoading(false);}};}

function openPayItemDefinitionModal(id=null){const d=arr(state.payItemBundle?.definitions).find(x=>x.id===id)||{};const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card thr117-modal-wide"><div class="thr117-eyebrow">PAY ITEM DEFINITION</div><h3>${id?'Edit':'Create'} pay item</h3><div class="thr117-form-grid"><label>Code<input id="pi-code" class="thr117-input" value="${esc(d.code||'')}" ${id?'readonly':''}></label><label>Label<input id="pi-label" class="thr117-input" value="${esc(d.label||'')}"></label><label>Type<select id="pi-type" class="thr117-select">${['earning','deduction','reimbursement','employer_contribution'].map(x=>`<option ${d.item_type===x?'selected':''}>${x}</option>`).join('')}</select></label><label>Recurrence<select id="pi-rec" class="thr117-select">${['one_off','recurring'].map(x=>`<option ${d.recurrence===x?'selected':''}>${x}</option>`).join('')}</select></label><label>Calculation<select id="pi-calc" class="thr117-select">${['fixed','rate_units','percentage_of_basic'].map(x=>`<option ${d.calculation_method===x?'selected':''}>${x}</option>`).join('')}</select></label><label>Default rate / amount<input id="pi-rate" class="thr117-input" type="number" step="0.0001" value="${d.default_rate??''}"></label><label>Percentage of basic (%)<input id="pi-pct" class="thr117-input" type="number" step="0.01" value="${obj(d.calculation_params).percentage??''}"></label><label>PCB treatment<select id="pi-pcb" class="thr117-select">${['review','normal','additional','non_taxable'].map(x=>`<option ${d.pcb_treatment===x?'selected':''}>${x}</option>`).join('')}</select></label><label>GL code<input id="pi-gl" class="thr117-input" value="${esc(d.gl_code||'')}"></label><label>Cost centre<input id="pi-cost" class="thr117-input" value="${esc(d.default_cost_center||'')}"></label></div><div class="thr117-form-grid"><label class="thr117-check"><input id="pi-epf" type="checkbox" ${d.epf_included?'checked':''}><span><b>EPF included</b></span></label><label class="thr117-check"><input id="pi-soc" type="checkbox" ${d.socso_included?'checked':''}><span><b>SOCSO / EIS included</b></span></label><label class="thr117-check"><input id="pi-prorate" type="checkbox" ${d.proratable?'checked':''}><span><b>Proratable</b></span></label></div><label class="thr117-field-label">Statutory / policy source reference<input id="pi-source" class="thr117-input" value="${esc(d.source_reference||'')}"></label><label class="thr117-check"><input id="pi-verified" type="checkbox" ${d.treatment_verified?'checked':''}><span><b>Treatment verified</b><small>Verified definitions require a source reference and can be applied to payroll.</small></span></label><div class="thr117-modal-actions"><button class="thr117-btn" id="pi-cancel">Cancel</button><button class="thr117-btn primary" id="pi-save">Save Definition</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#pi-cancel').onclick=()=>modal.remove();modal.querySelector('#pi-save').onclick=async()=>{const soc=modal.querySelector('#pi-soc').checked,calc=modal.querySelector('#pi-calc').value;try{setLoading(true);await rpc('thr_upsert_pay_item_definition_v121',{p_org_id:ORG_ID,p_id:id,p_code:modal.querySelector('#pi-code').value,p_version:d.version||1,p_label:modal.querySelector('#pi-label').value,p_item_type:modal.querySelector('#pi-type').value,p_recurrence:modal.querySelector('#pi-rec').value,p_calculation_method:calc,p_default_rate:modal.querySelector('#pi-rate').value?Number(modal.querySelector('#pi-rate').value):null,p_calculation_params:calc==='percentage_of_basic'?{percentage:Number(modal.querySelector('#pi-pct').value||0)}:{},p_pcb_treatment:modal.querySelector('#pi-pcb').value,p_epf_included:modal.querySelector('#pi-epf').checked,p_socso_included:soc,p_eis_included:soc,p_lindung24_included:false,p_proratable:modal.querySelector('#pi-prorate').checked,p_gl_code:modal.querySelector('#pi-gl').value||null,p_default_cost_center:modal.querySelector('#pi-cost').value||null,p_effective_from:d.effective_from||todayISO(),p_effective_to:d.effective_to||null,p_treatment_verified:modal.querySelector('#pi-verified').checked,p_source_reference:modal.querySelector('#pi-source').value||null,p_active:d.active!==false});modal.remove();await loadData(false);render();toast('Pay-item definition saved.');}catch(e){toast(e.message||'Definition validation failed.');}finally{setLoading(false);}};}
function openApplyPayItemModal(){const defs=arr(state.payItemBundle?.definitions).filter(d=>d.active&&d.treatment_verified&&d.pcb_treatment!=='review'),runs=currentDraftRuns();if(!defs.length){toast('Create and verify a pay-item definition first.');return;}if(!runs.length){toast('No Draft payroll run available.');return;}const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">APPLY PAY ITEM</div><h3>Add to Draft payroll</h3><label class="thr117-field-label">Payroll run<select id="ap-run" class="thr117-select">${selectOptions(runs,'id',r=>`${r.period_start} → ${r.period_end} · ${r.run_mode}`)}</select></label><label class="thr117-field-label">Employee<select id="ap-emp" class="thr117-select">${employeeOptions()}</select></label><label class="thr117-field-label">Pay item<select id="ap-def" class="thr117-select">${selectOptions(defs,'id',d=>`${d.code} · ${d.label}`)}</select></label><div class="thr117-form-grid"><label>Amount override<input id="ap-amount" class="thr117-input" type="number" step="0.01"></label><label>Units<input id="ap-units" class="thr117-input" type="number" step="0.01"></label><label>Rate override<input id="ap-rate" class="thr117-input" type="number" step="0.0001"></label></div><label class="thr117-field-label">Note<input id="ap-note" class="thr117-input"></label><div class="thr117-modal-actions"><button class="thr117-btn" id="ap-cancel">Cancel</button><button class="thr117-btn primary" id="ap-save">Apply</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#ap-cancel').onclick=()=>modal.remove();modal.querySelector('#ap-save').onclick=async()=>{try{setLoading(true);await rpc('thr_apply_pay_item_v121',{p_run_id:modal.querySelector('#ap-run').value,p_employee_id:modal.querySelector('#ap-emp').value,p_definition_id:modal.querySelector('#ap-def').value,p_amount:modal.querySelector('#ap-amount').value?Number(modal.querySelector('#ap-amount').value):null,p_units:modal.querySelector('#ap-units').value?Number(modal.querySelector('#ap-units').value):null,p_rate:modal.querySelector('#ap-rate').value?Number(modal.querySelector('#ap-rate').value):null,p_note:modal.querySelector('#ap-note').value||null});modal.remove();await loadData(false);render();toast('Pay item applied and payroll recalculated.');}catch(e){toast(e.message||'Unable to apply pay item.');}finally{setLoading(false);}};}
function openAttachClaimModal(claimId){const runs=currentDraftRuns();if(!runs.length){toast('No Draft payroll run available.');return;}const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">CLAIM → PAYROLL</div><h3>Attach approved reimbursement</h3><label class="thr117-field-label">Draft payroll<select id="ac-run" class="thr117-select">${selectOptions(runs,'id',r=>`${r.period_start} → ${r.period_end} · ${r.run_mode}`)}</select></label><