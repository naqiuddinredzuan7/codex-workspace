d} 0 R >> >> /Contents ${contentIds[idx]} 0 R >>`;objs[contentIds[idx]]=`<< /Length ${new TextEncoder().encode(stream).length} >>\nstream\n${stream}\nendstream`;});objs[fontId]='<< /Type /Font /Subtype /Type1 /BaseFont /Courier >>';
  let pdf='%PDF-1.4\n',offsets=[0];for(let i=1;i<objs.length;i++){offsets[i]=new TextEncoder().encode(pdf).length;pdf+=`${i} 0 obj\n${objs[i]}\nendobj\n`;}const xref=new TextEncoder().encode(pdf).length;pdf+=`xref\n0 ${objs.length}\n0000000000 65535 f \n`;for(let i=1;i<objs.length;i++)pdf+=`${String(offsets[i]).padStart(10,'0')} 00000 n \n`;pdf+=`trailer\n<< /Size ${objs.length} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF`;return new Blob([pdf],{type:'application/pdf'});
}

async function exportCurrentReport(format){
  const rows=reportRows();if(!rows.length){toast('Run a report first.');return;}const key=state.reportKey||'report';let blob,name;
  if(format==='csv'){const cols=reportCols(rows),cell=v=>`"${String(v??'').replace(/"/g,'""')}"`,text=[cols.map(cell).join(','),...rows.map(r=>cols.map(c=>cell(r[c])).join(','))].join('\n');blob=new Blob([text],{type:'text/csv;charset=utf-8'});name=`trust-${key}-${todayISO()}.csv`;}
  else if(format==='xlsx'){blob=xlsxBlob(rows,key);name=`trust-${key}-${todayISO()}.xlsx`;}
  else {blob=pdfBlob(`TRUST ${key.toUpperCase()} REPORT`,rows);name=`trust-${key}-${todayISO()}.pdf`;}
  const buf=await blob.arrayBuffer(),hash=await sha256Buffer(buf);downloadBlob(name,blob);
  await safe(rpc('thr_log_report_export_v121',{p_org_id:ORG_ID,p_report_key:key,p_export_format:format,p_filters:{start:state.reportStart,end:state.reportEnd},p_row_count:rows.length,p_content_hash:hash||null}),null);
  toast(`${format.toUpperCase()} report exported and audit logged.`);
}

function normalizeHeader(s){return String(s??'').toLowerCase().replace(/[^a-z0-9]+/g,'').trim();}
function parseCSVText(text){const rows=[];let row=[],cell='',q=false;for(let i=0;i<text.length;i++){const c=text[i],n=text[i+1];if(q){if(c==='"'&&n==='"'){cell+='"';i++;}else if(c==='"')q=false;else cell+=c;}else{if(c==='"')q=true;else if(c===','){row.push(cell);cell='';}else if(c==='\n'){row.push(cell.replace(/\r$/,''));rows.push(row);row=[];cell='';}else cell+=c;}}if(cell.length||row.length){row.push(cell.replace(/\r$/,''));rows.push(row);}return rows.filter(r=>r.some(x=>String(x).trim()!==''));}
async function inflateRaw(bytes){const ds=new DecompressionStream('deflate-raw');return new Uint8Array(await new Response(new Blob([bytes]).stream().pipeThrough(ds)).arrayBuffer());}
function dvU16(dv,o){return dv.getUint16(o,true);}function dvU32(dv,o){return dv.getUint32(o,true);}
async function unzipXlsx(buffer){const bytes=new Uint8Array(buffer),dv=new DataView(buffer);let eocd=-1;for(let i=bytes.length-22;i>=Math.max(0,bytes.length-65557);i--){if(dvU32(dv,i)===0x06054b50){eocd=i;break;}}if(eocd<0)throw new Error('Invalid XLSX ZIP container.');const total=dvU16(dv,eocd+10),centralOff=dvU32(dv,eocd+16),out={};let p=centralOff;const dec=new TextDecoder();for(let i=0;i<total;i++){if(dvU32(dv,p)!==0x02014b50)throw new Error('Invalid XLSX central directory.');const method=dvU16(dv,p+10),comp=dvU32(dv,p+20),nameLen=dvU16(dv,p+28),extra=dvU16(dv,p+30),comment=dvU16(dv,p+32),local=dvU32(dv,p+42),name=dec.decode(bytes.slice(p+46,p+46+nameLen));const localName=dvU16(dv,local+26),localExtra=dvU16(dv,local+28),start=local+30+localName+localExtra,part=bytes.slice(start,start+comp);out[name]=method===0?part:method===8?await inflateRaw(part):null;p+=46+nameLen+extra+comment;}return out;}
function excelSerial(v,withTime=false){const n=Number(v);if(!Number.isFinite(n))return v;const ms=Math.round((n-25569)*86400000);const d=new Date(ms);return withTime?d.toISOString().replace('T',' ').slice(0,19)+'+00:00':d.toISOString().slice(0,10);}
async function parseXlsx(buffer){const files=await unzipXlsx(buffer),dec=new TextDecoder(),parser=new DOMParser();const ss=[];if(files['xl/sharedStrings.xml']){const doc=parser.parseFromString(dec.decode(files['xl/sharedStrings.xml']),'text/xml');doc.querySelectorAll('si').forEach(si=>ss.push([...si.querySelectorAll('t')].map(t=>t.textContent||'').join('')));}const sheetName=Object.keys(files).find(k=>/^xl\/worksheets\/sheet\d+\.xml$/.test(k));if(!sheetName)throw new Error('XLSX has no worksheet.');const doc=parser.parseFromString(dec.decode(files[sheetName]),'text/xml');const matrix=[];doc.querySelectorAll('row').forEach(row=>{const a=[];row.querySelectorAll('c').forEach(c=>{const ref=c.getAttribute('r')||'',letters=(ref.match(/[A-Z]+/)||['A'])[0];let idx=0;for(const ch of letters)idx=idx*26+(ch.charCodeAt(0)-64);idx--;const type=c.getAttribute('t'),v=c.querySelector('v')?.textContent??'',inline=c.querySelector('is t')?.textContent;let val=inline??v;if(type==='s')val=ss[Number(v)]??'';else if(type==='b')val=v==='1';else if(!type&&v!==''&&Number.isFinite(Number(v)))val=Number(v);a[idx]=val;});matrix.push(a);});return matrix;}
async function parseSpreadsheetFile(file){const buf=await file.arrayBuffer();if(file.name.toLowerCase().endsWith('.xlsx'))return parseXlsx(buf);const text=new TextDecoder().decode(buf);return parseCSVText(text);}
function matrixObjects(matrix){if(!matrix.length)return {headers:[],rows:[]};const headers=matrix[0].map((h,i)=>String(h??`Column ${i+1}`).trim()||`Column ${i+1}`);return {headers,rows:matrix.slice(1).filter(r=>r.some(x=>String(x??'').trim()!=='')).map(r=>Object.fromEntries(headers.map((h,i)=>[h,r[i]??''])))};}
const importFields=['external_employee_key','employee_name','employee_email','work_date','punch_at','punch_type','attendance_days','worked_minutes','regular_minutes','overtime_minutes','break_minutes','late_minutes','early_leave_minutes','incomplete_days','approved_leave_days','absent_days','unpaid_leave_days','allowance','deduction','manual_basic_amount','manual_ot_amount','shift_code','night_shift_count','normal_ot_minutes','rest_day_ot_minutes','public_holiday_regular_minutes','public_holiday_ot_minutes'];
function autoMapping(headers,aliases){const map={};for(const f of importFields){const choices=[f.replaceAll('_',' '),...(arr(obj(aliases)[f]))].map(normalizeHeader);const hit=headers.find(h=>choices.includes(normalizeHeader(h)));if(hit)map[f]=hit;}return map;}
function canonicalRows(rows,map){return rows.map((r,i)=>{const out={row_number:i+2,raw_payload:r};for(const [f,h] of Object.entries(map)){let v=r[h];if((f==='work_date'||f==='punch_at')&&typeof v==='number')v=excelSerial(v,f==='punch_at');out[f]=v;}return out;});}

function openIntegrationImportModal(id){
  const a=arr(state.integrationBundle?.adapters).find(x=>x.id===id);if(!a)return;const cfg=obj(a.config),aliases=obj(cfg.aliases);const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card thr117-modal-wide"><div class="thr117-eyebrow">INTEGRATION IMPORT · ${esc(a.provider_key)}</div><h3>${esc(a.label)}</h3><p class="thr117-sub">CSV/XLSX is parsed locally. Original row payload is retained in the import batch for audit.</p><div class="thr117-form-grid"><label>Period start<input id="int-start" class="thr117-input" type="date" value="${esc(addDaysISO(-30))}"></label><label>Period end<input id="int-end" class="thr117-input" type="date" value="${esc(todayISO())}"></label><label class="thr117-field-span">Source file<input id="int-file" class="thr117-input" type="file" accept=".csv,.txt,.xlsx"></label></div><div id="int-map" class="thr117-section"></div><div id="int-result"></div><div class="thr117-modal-actions"><button class="thr117-btn" id="int-close">Close</button><button class="thr117-btn primary" id="int-prepare" disabled>Validate & Prepare</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#int-close').onclick=()=>modal.remove();let parsed=null,mapping={};
  modal.querySelector('#int-file').onchange=async ev=>{const file=ev.target.files?.[0];if(!file)return;try{setLoading(true);const matrix=await parseSpreadsheetFile(file),m=matrixObjects(matrix);parsed={...m,file};mapping=autoMapping(m.headers,aliases);modal.querySelector('#int-map').innerHTML=`<div class="thr117-section-title"><h2>Column mapping</h2><span class="thr117-sub">${m.rows.length} data row(s)</span></div><div class="thr117-form-grid">${importFields.map(f=>`<label>${esc(f.replaceAll('_',' '))}<select class="thr117-select int-map" data-field="${f}"><option value="">Not mapped</option>${m.headers.map(h=>`<option value="${esc(h)}" ${mapping[f]===h?'selected':''}>${esc(h)}</option>`).join('')}</select></label>`).join('')}</div><div class="thr117-callout"><b>Required identification</b><div class="thr117-sub">Map employee code/name/email. Raw-punch imports also require punch timestamp and punch type.</div></div>`;modal.querySelectorAll('.int-map').forEach(s=>s.onchange=()=>{mapping[s.dataset.field]=s.value||undefined;if(!s.value)delete mapping[s.dataset.field];});modal.querySelector('#int-prepare').disabled=false;}catch(e){toast(e.message||'Unable to parse file.');}finally{setLoading(false);}};
  modal.querySelector('#int-prepare').onclick=async()=>{if(!parsed)return;const source=cfg.source_system|| (a.provider_key==='hr_my'?'hr_my':a.provider_key==='fingertec'?'biometric':'generic'),kind=cfg.import_kind||'attendance_summary',start=modal.querySelector('#int-start').value,end=modal.querySelector('#int-end').value;if(!start||!end){toast('Set import period.');return;}try{setLoading(true);const batch=await rpc('thr_create_payroll_import_batch',{p_org_id:ORG_ID,p_source_system:source,p_import_kind:kind,p_file_name:parsed.file.name,p_period_start:start,p_period_end:end,p_column_mapping:mapping,p_metadata:{adapter_id:a.id,adapter_provider:a.provider_key,architecture_version:'v123'}});const rows=canonicalRows(parsed.rows,mapping);for(let i=0;i<rows.length;i+=150)await rpc('thr_append_payroll_import_rows',{p_batch_id:batch.id,p_rows:rows.slice(i,i+150)});const pre=await rpc('thr_smart_import_preflight_v104',{p_batch_id:batch.id});await safe(rpc('thr_log_integration_event_v123',{p_org_id:ORG_ID,p_adapter_id:a.id,p_direction:'import',p_status:'validated',p_source_reference:parsed.file.name,p_record_count:rows.length,p_accepted_count:Math.max(rows.length-Number(pre.unmatched_rows||0)-Number(pre.invalid_rows||0),0),p_rejected_count:Number(pre.unmatched_rows||0)+Number(pre.invalid_rows||0),p_content_hash:await sha256Text(JSON.stringify(rows)),p_metadata:{batch_id:batch.id,preflight:pre}}),null);modal.querySelector('#int-result').innerHTML=`<div class="thr117-${Number(pre.unmatched_rows||0)+Number(pre.invalid_rows||0)?'error':'callout'} thr117-section"><b>Preflight: ${rows.length} row(s) · ${Number(pre.unmatched_rows||0)} unmatched · ${Number(pre.invalid_rows||0)} invalid</b><div class="thr117-sub">Coverage ${esc(pre.coverage_pct??'—')}%. Batch ${esc(batch.id)} is preserved whether finalized or not.</div>${Number(pre.unmatched_rows||0)+Number(pre.invalid_rows||0)===0?'<button class="thr117-btn primary" id="int-finalize" style="margin-top:12px">Finalize Import</button>':'<div class="thr117-sub" style="margin-top:8px">Resolve employee mapping/invalid rows in Detailed Payroll Import before finalization.</div>'}</div>`;const fin=modal.querySelector('#int-finalize');if(fin)fin.onclick=async()=>{try{setLoading(true);await rpc('thr_finalize_payroll_import',{p_batch_id:batch.id});await safe(rpc('thr_log_integration_event_v123',{p_org_id:ORG_ID,p_adapter_id:a.id,p_direction:'import',p_status:'finalized',p_source_reference:parsed.file.name,p_record_count:rows.length,p_accepted_count:rows.length,p_rejected_count:0,p_content_hash:await sha256Text(JSON.stringify(rows)),p_metadata:{batch_id:batch.id}}),null);modal.remove();await loadData(false);render();toast('Import finalized into TRUST payroll/attendance inputs.');}catch(e){toast(e.message||'Finalize failed.');}finally{setLoading(false);}};}catch(e){await safe(rpc('thr_log_integration_event_v123',{p_org_id:ORG_ID,p_adapter_id:a.id,p_direction:'import',p_status:'failed',p_source_reference:parsed?.file?.name||null,p_record_count:parsed?.rows?.length||0,p_accepted_count:0,p_rejected_count:parsed?.rows?.length||0,p_content_hash:null,p_metadata:{error:String(e.message||e)}}),null);toast(e.message||'Import preparation failed.');}finally{setLoading(false);}};
}

function openApprovalModal(type,id){
  const item=arr(state.operationsBundle?.inbox).find(x=>x.item_type===type&&x.item_id===id)||{item_type:type,item_id:id};const modal=document.createElement('div');modal.className='thr117-modal';let extra='';if(type==='claim'){const c=arr(state.operationsBundle?.claims).find(x=>x.id===id);extra=`<label class="thr117-field-label">Partial approved amount (optional)<input id="approval-partial" class="thr117-input" type="number" step="0.01" min="0" max="${esc(c?.amount||0)}" placeholder="Leave blank for full approval"></label>`;}modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">UNIFIED APPROVAL</div><h3>${esc(item.title||type.replaceAll('_',' '))}</h3><p class="thr117-sub">${esc(item.employee_name||'')} ${esc(item.detail||'')}</p>${extra}<label class="thr117-field-label">Decision note<textarea id="approval-note" class="thr117-textarea" rows="3" placeholder="Reason / reviewer note"></textarea></label><div class="thr117-modal-actions"><button class="thr117-btn" id="approval-close">Cancel</button>${type==='payroll_review'?'<button class="thr117-btn" id="approval-return">Return Draft</button>':''}<button class="thr117-btn danger" id="approval-reject">Reject</button><button class="thr117-btn primary" id="approval-approve">Approve</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#approval-close').onclick=()=>modal.remove();const decide=async approve=>{const note=modal.querySelector('#approval-note').value||null;try{setLoading(true);if(type==='leave')await rpc('thr_decide_leave_v105',{p_leave_id:id,p_decision:approve?'approved':'rejected',p_note:note});else if(type==='attendance_correction')await rpc('thr_decide_attendance_correction_v107',{p_request_id:id,p_decision:approve?'approved':'rejected',p_note:note});else if(type==='overtime'){const q=arr(state.attendanceBundle?.overtime_requests).find(x=>x.id===id);await rpc('thr_decide_overtime_v107',{p_overtime_request_id:id,p_decision:approve?'approved':'rejected',p_note:note,p_approved_buckets:approve?{normal_ot_minutes:q?.requested_normal_ot_minutes||0,rest_day_ot_minutes:q?.requested_rest_day_ot_minutes||0,public_holiday_regular_minutes:q?.requested_public_holiday_regular_minutes||0,public_holiday_ot_minutes:q?.requested_public_holiday_ot_minutes||0}:null});}else if(type==='claim'){const partial=modal.querySelector('#approval-partial')?.value;await rpc('thr_decide_claim_v120',{p_claim_id:id,p_decision:approve?(partial?'partial':'approve'):'reject',p_approved_amount:partial?Number(partial):null,p_note:note});}else if(type==='profile_change')await rpc('thr_decide_profile_change_v120',{p_request_id:id,p_approve:approve,p_note:note});else if(type==='payroll_review'){if(!approve)throw new Error('Use Return Draft for payroll review rejection.');await rpc('thr_approve_payroll_run',{p_run_id:id});}modal.remove();await loadData(false);render();toast(`Decision saved: ${approve?'approved':'rejected'}.`);}catch(e){toast(e.message||'Decision failed.');}finally{setLoading(false);}};modal.querySelector('#approval-reject').onclick=()=>decide(false);modal.querySelector('#approval-approve').onclick=()=>decide(true);const ret=modal.querySelector('#approval-return');if(ret)ret.onclick=async()=>{try{setLoading(true);await rpc('thr_return_payroll_to_draft_v117',{p_run_id:id,p_reason:modal.querySelector('#approval-note').value||'Returned from Unified Approval Inbox'});modal.remove();await loadData(false);render();toast('Payroll returned to Draft.');}catch(e){toast(e.message||'Unable to return payroll.');}finally{setLoading(false);}};
}

function openClaimCategoryModal(){const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card thr117-modal-wide"><div class="thr117-eyebrow">CLAIM POLICY</div><h3>Create claim category</h3><div class="thr117-form-grid"><label>Code<input id="cc-code" class="thr117-input" placeholder="medical"></label><label>Label<input id="cc-label" class="thr117-input" placeholder="Medical Claim"></label><label>Per-claim limit<input id="cc-per" class="thr117-input" type="number" step="0.01"></label><label>Annual limit<inp