ass="thr117-field-label">Competency<select id="as-comp" class="thr117-select">${selectOptions(comps,'id',x=>`${x.code} · ${x.label}`)}</select></label><div class="thr117-form-grid"><label>Level<input id="as-level" class="thr117-input" type="number" min="0" step="0.01"></label><label>Date<input id="as-date" class="thr117-input" type="date" value="${todayISO()}"></label></div><label class="thr117-field-label">Evidence reference<input id="as-evidence" class="thr117-input"></label><label class="thr117-field-label">Notes<textarea id="as-notes" class="thr117-textarea"></textarea></label><div class="thr117-modal-actions"><button class="thr117-btn" id="as-cancel">Cancel</button><button class="thr117-btn primary" id="as-save">Save Assessment</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#as-cancel').onclick=()=>modal.remove();modal.querySelector('#as-save').onclick=async()=>{try{setLoading(true);await rpc('thr_record_employee_competency_v122',{p_org_id:ORG_ID,p_employee_id:modal.querySelector('#as-emp').value,p_competency_id:modal.querySelector('#as-comp').value,p_level:Number(modal.querySelector('#as-level').value||0),p_assessed_on:modal.querySelector('#as-date').value,p_source:'assessment',p_evidence_reference:modal.querySelector('#as-evidence').value||null,p_notes:modal.querySelector('#as-notes').value||null});modal.remove();await loadData(false);render();toast('Competency assessment saved.');}catch(e){toast(e.message||'Unable to save assessment.');}finally{setLoading(false);}};}
function openCourseModal(){const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">TRAINING COURSE</div><h3>New course</h3><div class="thr117-form-grid"><label>Code<input id="tr-code" class="thr117-input"></label><label>Title<input id="tr-title" class="thr117-input"></label><label>Provider<input id="tr-provider" class="thr117-input"></label><label>Provider registration<input id="tr-reg" class="thr117-input"></label><label>Delivery<select id="tr-mode" class="thr117-select"><option>classroom</option><option>online</option><option>hybrid</option><option>on_the_job</option><option>other</option></select></label><label>Duration hours<input id="tr-hours" class="thr117-input" type="number" step="0.5"></label><label>Default cost<input id="tr-cost" class="thr117-input" type="number" step="0.01"></label><label>Course reference<input id="tr-ref" class="thr117-input"></label></div><label class="thr117-check"><input id="tr-hrd" type="checkbox"><span><b>HRD Corp claimable</b><small>Only tick when verified for the actual course/provider.</small></span></label><div class="thr117-modal-actions"><button class="thr117-btn" id="tr-cancel">Cancel</button><button class="thr117-btn primary" id="tr-save">Create Course</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#tr-cancel').onclick=()=>modal.remove();modal.querySelector('#tr-save').onclick=async()=>{try{setLoading(true);await rpc('thr_upsert_training_course_v122',{p_org_id:ORG_ID,p_id:null,p_code:modal.querySelector('#tr-code').value,p_title:modal.querySelector('#tr-title').value,p_provider_name:modal.querySelector('#tr-provider').value||null,p_provider_registration_no:modal.querySelector('#tr-reg').value||null,p_course_reference:modal.querySelector('#tr-ref').value||null,p_delivery_mode:modal.querySelector('#tr-mode').value,p_duration_hours:modal.querySelector('#tr-hours').value?Number(modal.querySelector('#tr-hours').value):null,p_default_cost:modal.querySelector('#tr-cost').value?Number(modal.querySelector('#tr-cost').value):null,p_currency:'MYR',p_hrdcorp_claimable:modal.querySelector('#tr-hrd').checked,p_competency_links:[],p_active:true});modal.remove();await loadData(false);render();toast('Training course created.');}catch(e){toast(e.message||'Unable to create course.');}finally{setLoading(false);}};}
function openEnrollmentModal(id=null){const courses=arr(state.talentBundle?.courses).filter(c=>c.active),existing=arr(state.talentBundle?.enrollments).find(x=>x.id===id)||{};if(!courses.length){toast('Create a training course first.');return;}const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">TRAINING ENROLLMENT</div><h3>${id?'Update':'Enroll'} employee</h3><label class="thr117-field-label">Course<select id="en-course" class="thr117-select">${selectOptions(courses,'id',x=>x.title,existing.course_id)}</select></label><label class="thr117-field-label">Employee<select id="en-emp" class="thr117-select" ${id?'disabled':''}>${employeeOptions(existing.employee_id)}</select></label><div class="thr117-form-grid"><label>Status<select id="en-status" class="thr117-select">${['requested','approved','enrolled','completed','failed','cancelled'].map(x=>`<option ${existing.status===x?'selected':''}>${x}</option>`).join('')}</select></label><label>Session start<input id="en-start" class="thr117-input" type="date" value="${esc(existing.session_start||'')}"></label><label>Session end<input id="en-end" class="thr117-input" type="date" value="${esc(existing.session_end||'')}"></label><label>Actual cost<input id="en-cost" class="thr117-input" type="number" step="0.01" value="${existing.actual_cost??''}"></label><label>Completion score<input id="en-score" class="thr117-input" type="number" step="0.01" value="${existing.completion_score??''}"></label></div><label class="thr117-field-label">Evidence reference<input id="en-evidence" class="thr117-input" value="${esc(existing.evidence_reference||'')}"></label><label class="thr117-field-label">Completion notes<textarea id="en-notes" class="thr117-textarea">${esc(existing.completion_notes||'')}</textarea></label><div class="thr117-modal-actions"><button class="thr117-btn" id="en-cancel">Cancel</button><button class="thr117-btn primary" id="en-save">Save</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#en-cancel').onclick=()=>modal.remove();modal.querySelector('#en-save').onclick=async()=>{try{setLoading(true);await rpc('thr_upsert_training_enrollment_v122',{p_org_id:ORG_ID,p_id:id,p_course_id:modal.querySelector('#en-course').value,p_employee_id:id?existing.employee_id:modal.querySelector('#en-emp').value,p_status:modal.querySelector('#en-status').value,p_session_start:modal.querySelector('#en-start').value||null,p_session_end:modal.querySelector('#en-end').value||null,p_actual_cost:modal.querySelector('#en-cost').value?Number(modal.querySelector('#en-cost').value):null,p_currency:'MYR',p_completion_score:modal.querySelector('#en-score').value?Number(modal.querySelector('#en-score').value):null,p_completion_notes:modal.querySelector('#en-notes').value||null,p_evidence_reference:modal.querySelector('#en-evidence').value||null});modal.remove();await loadData(false);render();toast('Training enrollment saved.');}catch(e){toast(e.message||'Unable to save enrollment.');}finally{setLoading(false);}};}
function openCertificateModal(){const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">EMPLOYEE CERTIFICATE</div><h3>Add certificate</h3><label class="thr117-field-label">Employee<select id="ce-emp" class="thr117-select">${employeeOptions()}</select></label><label class="thr117-field-label">Certificate name<input id="ce-name" class="thr117-input"></label><div class="thr117-form-grid"><label>Issuer<input id="ce-issuer" class="thr117-input"></label><label>Certificate no<input id="ce-no" class="thr117-input"></label><label>Issue date<input id="ce-issue" class="thr117-input" type="date"></label><label>Expiry date<input id="ce-expiry" class="thr117-input" type="date"></label></div><label class="thr117-field-label">Evidence reference<input id="ce-evidence" class="thr117-input"></label><label class="thr117-check"><input id="ce-verified" type="checkbox"><span><b>Evidence verified</b></span></label><div class="thr117-modal-actions"><button class="thr117-btn" id="ce-cancel">Cancel</button><button class="thr117-btn primary" id="ce-save">Save Certificate</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#ce-cancel').onclick=()=>modal.remove();modal.querySelector('#ce-save').onclick=async()=>{try{setLoading(true);await rpc('thr_upsert_employee_certificate_v122',{p_org_id:ORG_ID,p_id:null,p_employee_id:modal.querySelector('#ce-emp').value,p_certificate_name:modal.querySelector('#ce-name').value,p_issuer:modal.querySelector('#ce-issuer').value||null,p_certificate_no:modal.querySelector('#ce-no').value||null,p_issue_date:modal.querySelector('#ce-issue').value||null,p_expiry_date:modal.querySelector('#ce-expiry').value||null,p_evidence_reference:modal.querySelector('#ce-evidence').value||null,p_verified:modal.querySelector('#ce-verified').checked,p_competency_links:[]});modal.remove();await loadData(false);render();toast('Certificate saved.');}catch(e){toast(e.message||'Unable to save certificate.');}finally{setLoading(false);}};}
function openRetentionModal(category){const s=arr(state.retentionBundle?.settings).find(x=>x.category===category)||{};const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">DOCUMENT RETENTION</div><h3>${esc(category.replaceAll('_',' '))}</h3><label class="thr117-field-label">Retention days<input id="re-days" class="thr117-input" type="number" min="1" max="36500" value="${esc(s.retention_days||'')}"></label><label class="thr117-field-label">Policy note<input id="re-note" class="thr117-input" value="${esc(s.notes||'')}"></label><div class="thr117-callout"><b>This sets policy metadata only.</b><div class="thr117-sub">This release does not delete existing documents or run a purge.</div></div><div class="thr117-modal-actions"><button class="thr117-btn" id="re-cancel">Cancel</button><button class="thr117-btn primary" id="re-save">Save Policy</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#re-cancel').onclick=()=>modal.remove();modal.querySelector('#re-save').onclick=async()=>{try{setLoading(true);await rpc('thr_update_document_retention_v113',{p_org_id:ORG_ID,p_category:category,p_retention_days:Number(modal.querySelector('#re-days').value),p_notes:modal.querySelector('#re-note').value||null});modal.remove();await loadData(false);render();toast('Retention policy saved; no files deleted.');}catch(e){toast(e.message||'Unable to save retention.');}finally{setLoading(false);}};}

async function handleV123Action(action,b){
  if(action==='ops-sub'){state.operationsSub=b.dataset.sub||'inbox';render();return true;}
  if(action==='ops-review'||action==='ops-review-direct'){openApprovalModal(b.dataset.type,b.dataset.id);return true;}
  if(action==='new-claim-category'){openClaimCategoryModal();return true;}
  if(action==='claim-treatment'){openClaimTreatmentModal(b.dataset.id);return true;}
  if(action==='new-claim'){openNewClaimModal();return true;}
  if(action==='new-profile-change'){openProfileChangeModal();return true;}
  if(action==='notification-read'){try{await rpc('thr_mark_notification_read_v120',{p_notification_id:b.dataset.id});await loadData(false);render();}catch(e){toast(e.message||'Unable to update notification.');}return true;}
  if(action==='new-pay-item'){openPayItemDefinitionModal();return true;}
  if(action==='edit-pay-item'){openPayItemDefinitionModal(b.dataset.id);return true;}
  if(action==='apply-pay-item'){openApplyPayItemModal();return true;}
  if(action==='attach-claim'){openAttachClaimModal(b.dataset.id);return true;}
  if(action==='report-key'){state.reportKey=b.dataset.key;state.reportData=null;render();return true;}
  if(action==='run-report'){const key=document.getElementById('report-key')?.value||state.reportKey,start=document.getElementById('report-start')?.value||state.reportStart,end=document.getElementById('report-end')?.value||state.reportEnd;state.reportKey=key;state.reportStart=start;state.reportEnd=end;try{setLoading(true);state.reportData=await rpc('thr_run_report_v121',{p_org_id:ORG_ID,p_report_key:key,p_start:start,p_end:end});render();}catch(e){toast(e.message||'Report failed.');}finally{setLoading(false);}return true;}
  if(action==='export-report'){await exportCurrentReport(b.dataset.format);return true;}
  if(action==='save-report-view'){const name=window.prompt('Saved view name');if(!name)return true;try{await rpc('thr_upsert_report_saved_view_v123',{p_org_id:ORG_ID,p_id:null,p_report_key:state.reportKey,p_name:name,p_filters:{start:state.reportStart,end:state.reportEnd},p_columns:reportCols(),p_sort:[],p_is_default:false});await loadData(false);render();toast('Report view saved.');}catch(e){toast(e.message||'Unable to save view.');}return true;}
  if(action==='load-report-view'){const v=arr(state.savedReportViews).find(x=>x.id===b.dataset.id);if(v){state.reportKey=v.report_key;state.reportStart=obj(v.filters).start||state.reportStart;state.reportEnd=obj(v.filters).end||state.reportEnd;state.reportData=null;render();}return true;}
  if(action==='new-adapter'){openAdapterModal();return true;}
  if(action==='configure-template'){openAdapterModal(null,b.dataset.key);return true;}
  if(action==='edit-adapter'){openAdapterModal(b.dataset.id);return true;}
  if(action==='integration-import'){openIntegrationImportModal(b.dataset.id);return true;}
  if(action==='gl-export'){await exportGenericGL(b.dataset.id);return true;}
  if(action==='statutory-export'){await statutoryExport(b.dataset.id,b.dataset.key);return true;}
  if(action==='talent-sub'){state.talentSub=b.dataset.sub||'pms';render();return true;}
  if(action==='new-cycle'){openCycleModal();return true;}
  if(action==='new-goal'){openGoalModal();return true;}
  if(action==='new-review'){openReviewModal();return true;}
  if(action==='calibrate-review'){openCalibrationModal(b.dataset.id);return true;}
  if(action==='new-competency'){openCompetencyModal();return true;}
  if(action==='new-assessment'){openAssessmentModal();return true;}
  if(action==='new-course'){openCourseModal();return true;}
  if(action==='new-enrollment'){openEnrollmentModal();return true;}
  if(action==='edit-enrollment'){openEnrollmentModal(b.dataset.id);return true;}
  if(action==='new-certificate'){openCertificateModal();return true;}
  if(action==='refresh-talent-alerts'){try{await rpc('thr_refresh_talent_alerts_v122',{p_org_id:ORG_ID,p_as_of:todayISO()});await loadData(false);render();toast('Certificate expiry alerts refreshed.');}catch(e){toast(e.message||'Unable to refresh alerts.');}return true;}
  if(action==='retention-edit'){openRetentionModal(b.dataset.key);return true;}
  return false;
}


function openPaymentDateModal(id){
  const run=(state.payrollRuns||[]).find(x=>x.id===id); if(!run) return;
  if(['approved','finalized'].includes(run.status)){toast('Approved/finalized payroll is locked.');return;}
  const modal=document.createElement('div');modal.className='thr117-modal';
  modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">PAYROLL PAYMENT DATE · v119</div><h3>Set verified payment date</h3><p class="thr117-sub">${fmtDate(run.period_start)} → ${fmtDate(run.period_end)} · ${esc(String(run.run_mode||'payroll').replace('_',' '))}</p><label class="thr117-field-label">Planned / actual salary payment date<input id="pd-date" class="thr117-input" type="date" value="${esc(run.payment_date||'')}"></label><label class="thr117-check"><input id="pd-verified" type="checkbox" ${run.payment_date_verified?'checked':''}><span><b>I verified this payment date</b><small>PCB deduction month/year will be derived from this date, not the payroll cutoff.</small></span></label><div class="thr117-callout" style="margin-top:14px"><b>Non-destructive v119 control</b><div class="thr117-sub">Changing the date marks PCB calculations stale. Existing calculation history is preserved; nothing is deleted.</div></div><div class="thr117-modal-actions"><button class="thr117-btn" id="pd-cancel">Cancel</button><button class="thr117-btn primary" id="pd-save">Save Verified Date</button></div></div>`;
  document.body.appendChild(modal);
  modal.querySelector('#pd-cancel').onclick=()=>modal.remove();
  modal.querySelector('#pd-save').onclick=async()=>{
    const date=modal.querySelector('#pd-date').value;
    const verified=modal.querySelector('#pd-veri