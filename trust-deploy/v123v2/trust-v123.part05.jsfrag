new TextEncoder().encode(text));return [...new Uint8Array(buf)].map(b=>b.toString(16).padStart(2,'0')).join('');}
async function sha256Buffer(buffer){if(!crypto?.subtle)return '';const digest=await crypto.subtle.digest('SHA-256',buffer);return [...new Uint8Array(digest)].map(b=>b.toString(16).padStart(2,'0')).join('');}

function operations(){
  const o=state.operationsBundle||{};
  const inbox=arr(o.inbox),claims=arr(o.claims),cats=arr(o.claim_categories),changes=arr(o.profile_changes),notes=arr(o.notifications);
  const pendingClaims=claims.filter(x=>x.status==='pending').length,payrollReady=claims.filter(x=>x.status==='payroll_ready').length,pendingChanges=changes.filter(x=>x.status==='pending').length,unread=notes.filter(x=>!x.read_at).length;
  const sub=state.operationsSub||'inbox';
  const actions=`<button class="thr117-btn ${sub==='inbox'?'primary':''}" data-action="ops-sub" data-sub="inbox">Approval Inbox ${inbox.length?`(${inbox.length})`:''}</button><button class="thr117-btn ${sub==='claims'?'primary':''}" data-action="ops-sub" data-sub="claims">Claims</button><button class="thr117-btn ${sub==='profile'?'primary':''}" data-action="ops-sub" data-sub="profile">Profile Changes</button><button class="thr117-btn ${sub==='notifications'?'primary':''}" data-action="ops-sub" data-sub="notifications">Notifications ${unread?`(${unread})`:''}</button>`;
  let body='';
  if(sub==='claims'){
    body=`<div class="thr117-grid thr117-kpis">${kpi('Claim Categories',cats.length,'active policies')}${kpi('Pending Claims',pendingClaims,'awaiting decision')}${kpi('Payroll Ready',payrollReady,'approved reimbursement')}${kpi('Claims Total',claims.length,'all recorded claims')}</div>
    <div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Claim policies</h2><div><button class="thr117-btn" data-action="new-claim-category">New Category</button><button class="thr117-btn primary" data-action="new-claim">New Claim</button></div></div>${cats.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Policy</th><th>Limits</th><th>Reimbursement</th><th>Statutory treatment</th><th>Action</th></tr></thead><tbody>${cats.map(c=>`<tr><td><b>${esc(c.label)}</b><div class="thr117-sub">${esc(c.code)}${c.requires_attachment?' · attachment required':''}</div></td><td>${c.per_claim_limit!=null?money(c.per_claim_limit):'No per-claim cap'}<div class="thr117-sub">${c.annual_limit!=null?`${money(c.annual_limit)} annual`:'No annual cap'}</div></td><td>${tag(c.reimbursement_mode||'payroll')}</td><td>${tag(c.treatment_verified?`${c.pcb_treatment} · verified`:`${c.pcb_treatment||'review'} · review`,c.treatment_verified?'ok':'warn')}<div class="thr117-sub">EPF ${c.epf_included?'Y':'N'} · SOCSO/EIS ${c.socso_included?'Y':'N'}</div></td><td><button class="thr117-btn" data-action="claim-treatment" data-id="${esc(c.id)}">Review Treatment</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">No claim policy configured yet. Create the real policies used by Teras HR; TRUST will not seed fake categories.</div>'}</div>
    <div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Claim register</h2><span class="thr117-sub">${claims.length} record(s)</span></div>${claims.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Employee</th><th>Category</th><th>Date</th><th>Amount</th><th>Status</th><th>Decision</th></tr></thead><tbody>${claims.map(c=>`<tr><td><b>${esc(c.employee_name)}</b><div class="thr117-sub">${esc(c.employee_code)}</div></td><td>${esc(c.category_label||c.category_code)}</td><td>${fmtDate(c.claim_date)}</td><td>${money(c.amount)}${c.approved_amount!=null?`<div class="thr117-sub">Approved ${money(c.approved_amount)}</div>`:''}</td><td>${tag(c.status,c.status==='pending'?'warn':c.status==='rejected'?'bad':'ok')}</td><td>${c.status==='pending'?`<button class="thr117-btn" data-action="ops-review-direct" data-type="claim" data-id="${esc(c.id)}">Review</button>`:'—'}</td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">No claims yet.</div>'}</div>`;
  } else if(sub==='profile'){
    body=`<div class="thr117-card"><div class="thr117-section-title"><h2>Employee profile change requests</h2><button class="thr117-btn primary" data-action="new-profile-change">New Request</button></div>${changes.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Employee</th><th>Requested</th><th>Submitted</th><th>Status</th><th>Action</th></tr></thead><tbody>${changes.map(p=>`<tr><td><b>${esc(p.employee_name)}</b><div class="thr117-sub">${esc(p.employee_code)}</div></td><td>${esc(Object.keys(obj(p.requested_changes)).join(', ')||'—')}</td><td>${fmtDateTime(p.submitted_at)}</td><td>${tag(p.status,p.status==='pending'?'warn':p.status==='rejected'?'bad':'ok')}</td><td>${p.status==='pending'?`<button class="thr117-btn" data-action="ops-review-direct" data-type="profile_change" data-id="${esc(p.id)}">Review</button>`:'—'}</td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">No profile-change requests.</div>'}</div>`;
  } else if(sub==='notifications'){
    body=`<div class="thr117-card"><div class="thr117-section-title"><h2>Action notifications</h2>${tag(`${unread} unread`,unread?'warn':'ok')}</div><div class="thr117-list">${notes.length?notes.map(n=>`<div class="thr117-list-item"><div><div class="thr117-name">${esc(n.title)}</div><div class="thr117-sub">${esc(n.body||n.event_type)} · ${fmtDateTime(n.created_at)}</div></div><div>${n.read_at?tag('Read','ok'):`<button class="thr117-btn" data-action="notification-read" data-id="${esc(n.id)}">Mark Read</button>`}</div></div>`).join(''):'<div class="thr117-empty">No notifications.</div>'}</div></div>`;
  } else {
    body=`<div class="thr117-grid thr117-kpis">${kpi('Approval Queue',inbox.length,'leave · OT · attendance · claim · profile · payroll')}${kpi('Pending Claims',pendingClaims,'claims requiring decision')}${kpi('Profile Changes',pendingChanges,'pending requests')}${kpi('Unread Alerts',unread,'action notifications')}</div>
    <div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Unified Approval Inbox</h2><span class="thr117-sub">Oldest work should be cleared first.</span></div>${inbox.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Type</th><th>Employee</th><th>Request</th><th>Submitted</th><th>Assigned</th><th>Action</th></tr></thead><tbody>${inbox.map(i=>`<tr><td>${tag(String(i.item_type||'').replaceAll('_',' '),i.item_type==='payroll_review'?'warn':'')}</td><td><b>${esc(i.employee_name||'Payroll')}</b><div class="thr117-sub">${esc(i.employee_code||'')}</div></td><td><b>${esc(i.title)}</b><div class="thr117-sub">${esc(i.detail||'')}</div></td><td>${fmtDateTime(i.submitted_at)}</td><td>${esc(i.assigned_role||'—')}</td><td><button class="thr117-btn primary" data-action="ops-review" data-type="${esc(i.item_type)}" data-id="${esc(i.item_id)}">Review</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">Approval queue is clear.</div>'}</div>`;
  }
  return `${head('HR OPERATIONS','Operations','One action centre for approvals, claims, profile changes and notifications.',actions)}${body}`;
}

function payItems(){
  const b=state.payItemBundle||{},defs=arr(b.definitions),queue=arr(b.claim_payroll_queue),drafts=currentDraftRuns();
  const verified=defs.filter(d=>d.treatment_verified&&d.pcb_treatment!=='review').length;
  return `${head('PAYROLL PLATFORM','Pay Items','Versioned earning, deduction and reimbursement definitions with statutory treatment evidence.',`<button class="thr117-btn" data-action="new-pay-item">New Pay Item</button><button class="thr117-btn primary" data-action="apply-pay-item">Apply to Draft Payroll</button>`)}
  <div class="thr117-grid thr117-kpis">${kpi('Definitions',defs.length,'tenant pay-item catalogue')}${kpi('Verified Treatment',`${verified}/${defs.length}`,defs.length?'ready to apply':'no definitions')}${kpi('Claim Queue',queue.length,'approved payroll reimbursements')}${kpi('Draft Runs',drafts.length,'eligible for additions')}</div>
  <div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Pay-item catalogue</h2><span class="thr117-sub">No unrestricted formulas or arbitrary code execution.</span></div>${defs.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Code</th><th>Type</th><th>Calculation</th><th>PCB</th><th>EPF / SOCSO / EIS</th><th>Evidence</th><th>Action</th></tr></thead><tbody>${defs.map(d=>`<tr><td><b>${esc(d.label)}</b><div class="thr117-sub">${esc(d.code)} · v${esc(d.version)}</div></td><td>${tag(d.item_type)}</td><td>${esc(d.calculation_method)}<div class="thr117-sub">${d.default_rate!=null?money(d.default_rate):'variable'}</div></td><td>${tag(d.pcb_treatment,d.treatment_verified?'ok':'warn')}</td><td>${d.epf_included?'EPF ':''}${d.socso_included?'SOCSO/EIS':''}${!d.epf_included&&!d.socso_included?'Excluded':' '}</td><td>${d.treatment_verified?`<span title="${esc(d.source_reference||'')}">${tag('Verified','ok')}</span>`:tag('Review required','warn')}</td><td><button class="thr117-btn" data-action="edit-pay-item" data-id="${esc(d.id)}">Edit</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">No configurable pay items yet. Existing fixed salary items continue to work; create definitions only for real client policies.</div>'}</div>
  <div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Approved claim reimbursement queue</h2><span class="thr117-sub">Claims are attached only to Draft payroll and only after category treatment is verified.</span></div>${queue.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Employee</th><th>Category</th><th>Approved</th><th>Claim date</th><th>Action</th></tr></thead><tbody>${queue.map(q=>`<tr><td>${esc(q.employee_code)} · ${esc(q.employee_name)}</td><td>${esc(q.category_label)}</td><td><b>${money(q.approved_amount)}</b></td><td>${fmtDate(q.claim_date)}</td><td><button class="thr117-btn primary" data-action="attach-claim" data-id="${esc(q.claim_id)}">Attach to Payroll</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">No payroll-ready claims.</div>'}</div>`;
}

function reportRows(){return arr(state.reportData?.rows);}
function reportCols(rows=reportRows()){if(!rows.length)return [];const all=[];rows.forEach(r=>Object.keys(obj(r)).forEach(k=>{if(!all.includes(k))all.push(k);}));return all;}
function reportSummaryHtml(){const s=obj(state.reportData?.summary);return Object.keys(s).length?`<div class="thr117-grid thr117-kpis">${Object.entries(s).slice(0,8).map(([k,v])=>kpi(k.replaceAll('_',' '),typeof v==='number'?String(v):String(v??'—'),'report summary')).join('')}</div>`:'';}
function reportDataTable(){const rows=reportRows(),cols=reportCols(rows);if(!rows.length)return '<div class="thr117-empty">Run a report to see results.</div>';return `<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr>${cols.map(c=>`<th>${esc(c.replaceAll('_',' '))}</th>`).join('')}</tr></thead><tbody>${rows.slice(0,500).map(r=>`<tr>${cols.map(c=>`<td>${esc(r[c]??'')}</td>`).join('')}</tr>`).join('')}</tbody></table></div>${rows.length>500?`<div class="thr117-callout">Preview limited to 500 rows; exports include all ${rows.length} rows.</div>`:''}`;}
function reports(){
  const catalog=arr(state.reportCatalog),views=arr(state.savedReportViews),key=state.reportKey||'workforce';
  const actions=`<select id="report-key" class="thr117-select">${catalog.map(c=>`<option value="${esc(c.key)}" ${c.key===key?'selected':''}>${esc(c.name)}</option>`).join('')}</select><input id="report-start" class="thr117-input" type="date" value="${esc(state.reportStart)}"><input id="report-end" class="thr117-input" type="date" value="${esc(state.reportEnd)}"><button class="thr117-btn primary" data-action="run-report">Run Report</button>`;
  return `${head('REPORTING CENTRE','Reports','Reusable secured reports with saved filters and audited CSV, XLSX and PDF exports.',actions)}
  <div class="thr117-grid thr117-three">${catalog.map(c=>`<button class="thr117-card thr117-report-card ${c.key===key?'selected':''}" data-action="report-key" data-key="${esc(c.key)}"><div class="thr117-eyebrow">${esc(c.domain)}</div><h2>${esc(c.name)}</h2><p class="thr117-sub">${c.key==='workforce'?'Employee directory and readiness':c.key==='payroll'?'Run totals and lifecycle':c.key==='statutory'?'EPF · SOCSO · EIS · PCB':c.key==='leave'?'Leave requests and utilisation':c.key==='claims'?'Claim register and approvals':'Unified action queue'}</p></button>`).join('')}</div>
  <div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Saved views</h2><button class="thr117-btn" data-action="save-report-view">Save Current Filters</button></div>${views.length?`<div class="thr117-chip-row">${views.map(v=>`<button class="thr117-btn" data-action="load-report-view" data-id="${esc(v.id)}">${v.is_default?'★ ':''}${esc(v.name)} · ${esc(v.report_key)}</button>`).join('')}</div>`:'<div class="thr117-sub">No saved views yet.</div>'}</div>
  ${state.reportData?`${reportSummaryHtml()}<div class="thr117-card thr117-section"><div class="thr117-section-title"><div><h2>${esc(key.replaceAll('_',' '))} report</h2><div class="thr117-sub">${fmtDate(state.reportData.start_date)} → ${fmtDate(state.reportData.end_date)} · ${reportRows().length} row(s)</div></div><div><button class="thr117-btn" data-action="export-report" data-format="csv">CSV</button><button class="thr117-btn" data-action="export-report" data-format="xlsx">XLSX</button><button class="thr117-btn primary" data-action="export-report" data-format="pdf">PDF</button></div></div>${reportDataTable()}</div>`:`<div class="thr117-callout thr117-section"><b>Select a report and date range, then Run Report.</b><div class="thr117-sub">Exports are generated locally from the secured report payload and logged with a SHA-256 content hash.</div></div>`}`;
}

function integrations(){
  const b=state.integrationBundle||{},adapters=arr(b.adapters),events=arr(b.events),templates=arr(state.integrationTemplates);
  const latestApproved=approvedRuns()[0];
  return `${head('INTEGRATIONS','Integrations','Versioned adapters for attendance, payroll, statutory, bank and accounting flows.',`<button class="thr117-btn primary" data-action="new-adapter">New Adapter</button>`)}
  <div class="thr117-grid thr117-kpis">${kpi('Configured',adapters.length,'tenant adapters')}${kpi('Templates',templates.length,'HR.my · biometric · generic')}${kpi('Audit Events',events.length,'latest integration activity')}${kpi('Approved Payroll',approvedRuns().length,'available output runs')}</div>
  <div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Quick-start templates</h2><span class="thr117-sub">Templates are mapping hints, not claims of vendor certification.</span></div><div class="thr117-grid thr117-three">${templates.map(t=>`<div class="thr117-card inner"><div class="thr117-eyebrow">${esc(t.adapter_type)} · ${esc(t.direction)}</div><h2>${esc(t.label)}</h2><p class="thr117-sub">${esc(t.note||'')}</p><button class="thr117-btn primary" data-action="configure-template" data-key="${esc(t.provider_key)}">Configure</button></div>`).join('')}</div></div>
  <div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Configured adapters</h2></div>${adapters.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Adapter</th><th>Type</th><th>Direction</th><th>Format</th><th>Effective</th><th>Action</th></tr></thead><tbody>${adapters.map(a=>`<tr><td><b>${esc(a.label)}</b><div class="thr117-sub">${esc(a.provider_key)}</div></td><td>${tag(a.adapter_type)}</td><td>${esc(a.direction)}</td><td>${esc(a.format_version)}</td><td>${fmtDate(a.effective_from)}</td><td><button class="thr117-btn" data-action="edit-adapter" data-id="${esc(a.id)}">Edit</button>${['import','bidirectional'].includes(a.direction)?` <button class="thr117-btn primary" data-action="integration-import" data-id="${esc(a.id)}">Import File</button>`:''}${['export','bidirectional'].includes(a.direction)&&a.adapter_type==='accounting'?` <button class="thr117-btn primary" data-action="gl-export" data-id="${esc(a.id)}">GL Export</button>`:''}</td></tr>`).join('')}</tbody></table></div>`