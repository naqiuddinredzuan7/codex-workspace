n'}));toast(`${key} generated from locked payroll.`);}catch(e){toast(e.message||'Statutory export blocked.');}finally{setLoading(false);}}

function openCycleModal(){const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">PERFORMANCE CYCLE</div><h3>New performance cycle</h3><label class="thr117-field-label">Name<input id="cy-name" class="thr117-input"></label><div class="thr117-form-grid"><label>Start<input id="cy-start" class="thr117-input" type="date" value="${todayISO()}"></label><label>End<input id="cy-end" class="thr117-input" type="date"></label><label>Status<select id="cy-status" class="thr117-select"><option>draft</option><option>open</option></select></label><label>Review model<select id="cy-model" class="thr117-select"><option>manager</option><option>self_manager</option><option>360</option></select></label><label>Rating max<input id="cy-rating" class="thr117-input" type="number" value="5" min="1"></label></div><div class="thr117-modal-actions"><button class="thr117-btn" id="cy-cancel">Cancel</button><button class="thr117-btn primary" id="cy-save">Create</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#cy-cancel').onclick=()=>modal.remove();modal.querySelector('#cy-save').onclick=async()=>{try{setLoading(true);await rpc('thr_upsert_performance_cycle_v122',{p_org_id:ORG_ID,p_id:null,p_name:modal.querySelector('#cy-name').value,p_cycle_start:modal.querySelector('#cy-start').value,p_cycle_end:modal.querySelector('#cy-end').value,p_status:modal.querySelector('#cy-status').value,p_review_model:modal.querySelector('#cy-model').value,p_rating_scale_max:Number(modal.querySelector('#cy-rating').value||5),p_goal_weight_required:true,p_config:{}});modal.remove();await loadData(false);render();toast('Performance cycle created.');}catch(e){toast(e.message||'Unable to create cycle.');}finally{setLoading(false);}};}
function openGoalModal(){const cycles=arr(state.talentBundle?.cycles);if(!cycles.length){toast('Create a performance cycle first.');return;}const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">PERFORMANCE GOAL</div><h3>Set employee goal</h3><label class="thr117-field-label">Cycle<select id="go-cycle" class="thr117-select">${selectOptions(cycles,'id',x=>x.name)}</select></label><label class="thr117-field-label">Employee<select id="go-emp" class="thr117-select">${employeeOptions()}</select></label><label class="thr117-field-label">Title<input id="go-title" class="thr117-input"></label><div class="thr117-form-grid"><label>Weight %<input id="go-weight" class="thr117-input" type="number" value="0" min="0" max="100"></label><label>Target value<input id="go-target" class="thr117-input" type="number" step="0.01"></label><label>Target unit<input id="go-unit" class="thr117-input"></label></div><label class="thr117-field-label">Description<textarea id="go-desc" class="thr117-textarea"></textarea></label><div class="thr117-modal-actions"><button class="thr117-btn" id="go-cancel">Cancel</button><button class="thr117-btn primary" id="go-save">Save Goal</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#go-cancel').onclick=()=>modal.remove();modal.querySelector('#go-save').onclick=async()=>{try{setLoading(true);await rpc('thr_upsert_performance_goal_v122',{p_org_id:ORG_ID,p_id:null,p_cycle_id:modal.querySelector('#go-cycle').value,p_employee_id:modal.querySelector('#go-emp').value,p_title:modal.querySelector('#go-title').value,p_description:modal.querySelector('#go-desc').value||null,p_weight:Number(modal.querySelector('#go-weight').value||0),p_target_value:modal.querySelector('#go-target').value?Number(modal.querySelector('#go-target').value):null,p_target_unit:modal.querySelector('#go-unit').value||null,p_actual_value:null,p_status:'active',p_employee_comment:null,p_manager_comment:null});modal.remove();await loadData(false);render();toast('Performance goal saved.');}catch(e){toast(e.message||'Unable to save goal.');}finally{setLoading(false);}};}
function openReviewModal(){const cycles=arr(state.talentBundle?.cycles).filter(c=>['open','calibration'].includes(c.status));if(!cycles.length){toast('Open a performance cycle first.');return;}const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">PERFORMANCE REVIEW</div><h3>Submit manager review</h3><label class="thr117-field-label">Cycle<select id="rv-cycle" class="thr117-select">${selectOptions(cycles,'id',x=>x.name)}</select></label><label class="thr117-field-label">Employee<select id="rv-emp" class="thr117-select">${employeeOptions()}</select></label><label class="thr117-field-label">Overall rating<input id="rv-rating" class="thr117-input" type="number" step="0.01" min="0" max="5"></label><label class="thr117-field-label">Strengths<textarea id="rv-strength" class="thr117-textarea"></textarea></label><label class="thr117-field-label">Development areas<textarea id="rv-dev" class="thr117-textarea"></textarea></label><label class="thr117-field-label">Summary<textarea id="rv-summary" class="thr117-textarea"></textarea></label><div class="thr117-modal-actions"><button class="thr117-btn" id="rv-cancel">Cancel</button><button class="thr117-btn primary" id="rv-save">Submit Review</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#rv-cancel').onclick=()=>modal.remove();modal.querySelector('#rv-save').onclick=async()=>{try{setLoading(true);await rpc('thr_submit_performance_review_v122',{p_org_id:ORG_ID,p_cycle_id:modal.querySelector('#rv-cycle').value,p_employee_id:modal.querySelector('#rv-emp').value,p_reviewer_type:'manager',p_overall_rating:modal.querySelector('#rv-rating').value?Number(modal.querySelector('#rv-rating').value):null,p_responses:{},p_strengths:modal.querySelector('#rv-strength').value||null,p_development_areas:modal.querySelector('#rv-dev').value||null,p_summary:modal.querySelector('#rv-summary').value||null});modal.remove();await loadData(false);render();toast('Review submitted.');}catch(e){toast(e.message||'Unable to submit review.');}finally{setLoading(false);}};}
function openCalibrationModal(id){const r=arr(state.talentBundle?.reviews).find(x=>x.id===id);if(!r)return;const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">CALIBRATION</div><h3>${esc(r.employee_name)}</h3><p class="thr117-sub">Submitted rating ${esc(r.overall_rating??'—')}</p><label class="thr117-field-label">Calibrated rating<input id="cal-rating" class="thr117-input" type="number" step="0.01" value="${esc(r.calibrated_rating??r.overall_rating??'')}"></label><label class="thr117-field-label">Calibration note<textarea id="cal-note" class="thr117-textarea"></textarea></label><div class="thr117-modal-actions"><button class="thr117-btn" id="cal-cancel">Cancel</button><button class="thr117-btn primary" id="cal-save">Save</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#cal-cancel').onclick=()=>modal.remove();modal.querySelector('#cal-save').onclick=async()=>{try{setLoading(true);await rpc('thr_calibrate_performance_review_v122',{p_review_id:id,p_calibrated_rating:Number(modal.querySelector('#cal-rating').value),p_note:modal.querySelector('#cal-note').value||null});modal.remove();await loadData(false);render();toast('Review calibrated.');}catch(e){toast(e.message||'Calibration failed.');}finally{setLoading(false);}};}
function openCompetencyModal(){const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">COMPETENCY</div><h3>New competency</h3><label class="thr117-field-label">Code<input id="co-code" class="thr117-input"></label><label class="thr117-field-label">Label<input id="co-label" class="thr117-input"></label><label class="thr117-field-label">Category<input id="co-cat" class="thr117-input"></label><label class="thr117-field-label">Description<textarea id="co-desc" class="thr117-textarea"></textarea></label><div class="thr117-modal-actions"><button class="thr117-btn" id="co-cancel">Cancel</button><button class="thr117-btn primary" id="co-save">Create</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#co-cancel').onclick=()=>modal.remove();modal.querySelector('#co-save').onclick=async()=>{try{setLoading(true);await rpc('thr_upsert_competency_v122',{p_org_id:ORG_ID,p_id:null,p_code:modal.querySelector('#co-code').value,p_label:modal.querySelector('#co-label').value,p_category:modal.querySelector('#co-cat').value||null,p_description:modal.querySelector('#co-desc').value||null,p_level_scale:[{level:1,label:'Awareness'},{level:2,label:'Working'},{level:3,label:'Proficient'},{level:4,label:'Advanced'},{level:5,label:'Expert'}],p_active:true});modal.remove();await loadData(false);render();toast('Competency created.');}catch(e){toast(e.message||'Unable to create competency.');}finally{setLoading(false);}};}
function openAssessmentModal(){const comps=arr(state.talentBundle?.competency_catalog).filter(c=>c.active);if(!comps.length){toast('Create a competency first.');return;}const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">COMPETENCY ASSESSMENT</div><h3>Record employee level</h3><label class="thr117-field-label">Employee<select id="as-emp" class="thr117-select">${employeeOptions()}</select></label><label class="thr117-field-label">Competency<select id="as-comp" class="thr117-select">${selectOptions(comps,'id',x=>`${x.code} · ${x.label}`)}</select></label><div class="thr117-form-grid"><label>Level<input id="as-level" class="thr117-input" type="number" min="0" step="0.01"></label><label>Date<input id="as-date" class="thr117-input" type="date" value="${todayISO()}"></label></div><label class="thr117-field-label">Evidence reference<input id="as-evidence" class="thr117-input"></label><label class="thr117-field-label">Notes<textarea id="as-notes" class="thr117-textarea"></textarea></label><div class="thr117-modal-actions"><button class="thr117-btn" id="as-cancel">Cancel</button><button class="thr117-btn primary" id="as-save">Save Assessment</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#as-cancel').onclick=()=>modal.remove();modal.querySelector('#as-save').onclick=async()=>{try{setLoading(true);await rpc('thr_record_employee_competency_v122',{p_org_id:ORG_ID,p_employee_id:modal.querySelector('#as-emp').value,p_competency_id:modal.querySelector('#as-comp').value,p_level:Number(modal.querySelector('#as-level').value||0),p_assessed_on:modal.querySelector('#as-date').value,p_source:'assessment',p_evidence_reference:modal.querySelector('#as-evidence').value||null,p_notes:modal.querySelector('#as-notes').value||null});modal.remove();await loadData(false);render();toast('Competency assessment saved.');}catch(e){toast(e.message||'Unable to save assessment.');}finally{setLoading(false);}};}
function openCourseModal(){const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">TRAINING COURSE</div><h3>New course</h3><div class="thr117-form-grid"><label>Code<input id="tr-code" class="thr117-input"></label><label>Title<input id="tr-title" class="thr117-input"></label><label>Provider<input id="tr-provider" class="thr117-input"></label><label>Provider registration<input id="tr-reg" class="thr117-input"></label><label>Delivery<select id="tr-mode" class="thr117-select"><option>classroom</option><option>online</option><option>hybrid</option><option>on_the_job</option><option>other</option></select></label><label>Duration hours<input id="tr-hours" class="thr117-input" type="number" step="0.5"></label><label>Default cost<input id="tr-cost" class="thr117-input" type="number" step="0.01"></label><label>Course reference<input id="tr-ref" class="thr117-input"></label></div><label class="thr117-check"><input id="tr-hrd" type="checkbox"><span><b>HRD Corp claimable</b><small>Only tick when verified for the actual course/provider.</small></span></label><div class="thr117-modal-actions"><button class="thr117-btn" id="tr-cancel">Cancel</button><button class="thr117-btn primary" id="tr-save">Create Course</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#tr-cancel').onclick=()=>modal.remove();modal.querySelector('#tr-save').onclick=async()=>{try{setLoading(true);await rpc('thr_upsert_training_course_v122',{p_org_id:ORG_ID,p_id:null,p_code:modal.querySelector('#tr-code').value,p_title:modal.querySelector('#tr-title').value,p_provider_name:modal.querySelector('#tr-provider').value||null,p_provider_registration_no:modal.querySelector('#tr-reg').value||null,p_course_reference:modal.querySelector('#tr-ref').value||null,p_delivery_mode:modal.querySelector('#tr-mode').value,p_duration_hours:modal.querySelector('#tr-hours').value?Number(modal.querySelector('#tr-hours').value):null,p_default_cost:modal.querySelector('#tr-cost').value?Number(modal.querySelector('#tr-cost').value):null,p_currency:'MYR',p_hrdcorp_claimable:modal.querySelector('#tr-hrd').checked,p_competency_links:[],p_active:true});modal.remove();await loadData(false);render();toast('Training course created.');}catch(e){toast(e.message||'Unable to create course.');}finally{setLoading(false);}};}
function openEnrollmentModal(id=null){const courses=arr(state.talentBundle?.courses).filter(c=>c.active),existing=arr(state.talentBundle?.enrollments).find(x=>x.id===id)||{};if(!courses.length){toast('Create a training course first.');return;}const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">TRAINING ENROLLMENT</div><h3>${id?'Update':'Enroll'} employee</h3><label class="thr117-field-label">Course<select id="en-course" class="thr117-select">${selectOptions(courses,'id',x=>x.title,existing.course_id)}</select></label><label class="thr117-field-label">Employee<select id="en-emp" class="thr117-select" ${id?'disabled':''}>${employeeOptions(existing.employee_id)}</select></label><div class="thr117-form-grid"><label>Status<select id="en-status" class="thr117-select">${['requested','approved','enrolled','completed','failed','cancelled'].map(x=>`<option ${existing.status===x?'selected':''}>${x}</option>`).join('')}</select></label><label>Session start<input id="en-start" class="thr117-input" type="date" value="${esc(existing.session_start||'')}"></label><label>Session end<input id="en-end" class="thr117-input" type="date" value="${esc(existing.session_end||'')}"></label><label>Actual cost<input id="en-cost" class="thr117-input" type="number" step="0.01" value="${existing.actual_cost??''}"></label><label>Completion score<input id="en-score" class="thr117-input" type="number" step="0.01" value="${existing.completion_score??''}"></label></div><label class="thr117-field-label">Evidence reference<input id="en-evidence" class="thr117-input" value="${esc(existing.evidence_reference||'')}"></label><label class="thr117-field-label">Completion notes<textarea id="en-notes" class="thr117-textarea">${esc(existing.completion_notes||'')}</textarea></label><div class="thr117-modal-actions"><button class="thr117-btn" id="en-cancel">Cancel</button><button class="thr117-btn primary" id="en-save">Save</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#en-cancel').onclick=()=>modal.remove();modal.querySelector('#en-save').onclick=async()=>{try{setLoading(true);await rpc('thr_upsert_training_enrollment_v122',{p_org_id:ORG_ID,p_id:id,p_course_id:modal.querySelector('#en-course').value,p_employee_id:id?existing.employee_id:modal.querySelector('#en-emp').value,p_status:modal.querySelector('#en-status').value,p_session_start:modal.querySelector('#en-start').value||null,p_session_end:modal.querySelector('#en-end').value||null,p_actual_cost:modal.querySelector('#en-cost').value?Number(modal.querySelector('#en-cost').value):null,p_currency:'MYR',p_completion_score:modal.querySelector('#en-score').value?Number(modal.querySelector('#en-score').value):null,p_completion_notes:modal.querySelector('#en-notes').value||null,p_evidence_reference:modal.querySelector('#en-evidence').value||null});modal.remove();await loadData(false);render();toast('Training enrollment saved.');}catch(e){toast(e.message||'Unable to save enrollment.');}finally{setLoading(false);}};}
function openCertificateModal(){const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">EMPLOYEE CERTIFICATE</div><h3>Add certificate</h3><label class="thr117-field-label">Employee<select id="ce-emp" class="thr117-select">${employeeOptions()}</select></label><label class="thr117-field-label">Certificate name<input id="ce-name" class="thr117-input"></label><div class="thr117-form-grid"><label>Issuer<input id="ce-issuer" class="thr117-input"></label><label>Certificate no<input id="ce-no" class="thr117-input"></label><label>Issue date<input id="ce-issue" class="thr117-input" type="date"></label><label>Expiry date<input id="ce-expiry" class="thr117-input" type="date"></label></div><label class="thr117-field-label">Evidence reference<input id="ce-evidence" class="thr117-input"></label><label class="thr117-check"><input id="ce-verified" type="checkbox"><span><b>Evidence verified</b></span></label><div class="thr117-modal-actions"><button class="thr117-btn" id="ce-cancel">Cancel</button><button class="thr117-btn primary" id="ce-save">Save Certificate</button></div></div>`;document.body.appendChild(modal);modal.querySelector('#ce-cancel').onclick=()=>modal.remove();modal.querySelector('#ce-save').onclick=async()=>{try{setLoading(true);await rpc('thr_upsert_employee_certificate_v122',{p_org_id:ORG_ID,p_id:null,p_employee_id:modal.querySelector('#ce-emp').value,p_certificate_name:modal.querySelector('#ce-name').value,p_issuer:modal.querySelector('#ce-issuer').value||null,p_certificate_no:modal.querySelector('#ce-no').value||null,p_issue_date:modal.querySelector('#ce-issue').value||null,p_expiry_date:modal.querySelector('#ce-expiry').value||null,p_evidence_reference:modal.querySelector('#ce-evidence').value||null,p_verified:modal.querySelector('#ce-verified').checked,p_competency_links:[]});modal.remove();await loadData(false);render();toast('Certificate saved.');}catch(e){toast(e.message||'Unable to save certificate.');}finally{setLoading(false);}};}
function openRetentionModal(category){const s=arr(state.retentionBundle?.settings).find(x=>x.category===category)||{};const modal=document.createElement('div');modal.className='thr117-modal';modal.innerHTML=`<div class="thr117-modal-card"><div class="thr117-eyebrow">DOCUMENT RETENTION</div><h3>${esc(category.replaceAll('_',' '))}</h3><label class="thr117-field-label">Retention days<input id="re-days" class="thr117-input" type="number" min="1" max="36500" value="${esc(s.retention_days||'')}"></label><label class="thr117-field-label">Policy note<input id="re-note" class="thr117-input" value="${esc(s.notes||'')}"></label><div class="thr117-callout"><b>This sets policy metadata only.</b><div class="thr117-sub">This release does not delete existing documents or run a purge.</div></div><div class="thr117-modal-actions"><button class="thr117-btn" id="re