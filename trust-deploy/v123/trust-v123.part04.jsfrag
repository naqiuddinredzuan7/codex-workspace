ayroll export engine.</span></div>${latestApproved?`<div class="thr117-chip-row"><button class="thr117-btn" data-action="statutory-export" data-key="kwsp_ecaruman_csv" data-id="${esc(latestApproved.id)}">KWSP e-Caruman CSV</button><button class="thr117-btn" data-action="statutory-export" data-key="perkeso_assist_combine_v21" data-id="${esc(latestApproved.id)}">PERKESO ASSIST v2.1</button><button class="thr117-btn" data-action="statutory-export" data-key="cp39" data-id="${esc(latestApproved.id)}">LHDN CP39</button><button class="thr117-btn" data-action="legacy-payroll">Bank / Payment Batch</button></div>`:'<div class="thr117-empty">No approved payroll run yet; statutory/bank files correctly remain unavailable.</div>'}</div>
  <div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Integration audit</h2></div><div class="thr117-list">${events.length?events.slice(0,30).map(e=>`<div class="thr117-list-item"><div><div class="thr117-name">${esc(e.direction)} · ${esc(e.status)}</div><div class="thr117-sub">${esc(e.source_reference||'No reference')} · ${fmtDateTime(e.created_at)}</div></div><div>${tag(`${e.accepted_count??0}/${e.record_count??0}`,e.status==='failed'?'bad':'ok')}</div></div>`).join(''):'<div class="thr117-empty">No integration events yet.</div>'}</div></div>`;
}

function talent(){
  const t=state.talentBundle||{},sub=state.talentSub||'pms',cycles=arr(t.cycles),goals=arr(t.goals),reviews=arr(t.reviews),comps=arr(t.competency_catalog),ec=arr(t.employee_competencies),courses=arr(t.courses),enroll=arr(t.enrollments),certs=arr(t.certificates);
  const actions=`<button class="thr117-btn ${sub==='pms'?'primary':''}" data-action="talent-sub" data-sub="pms">Performance</button><button class="thr117-btn ${sub==='competency'?'primary':''}" data-action="talent-sub" data-sub="competency">Competency</button><button class="thr117-btn ${sub==='training'?'primary':''}" data-action="talent-sub" data-sub="training">Training & Certificates</button>`;
  let body='';
  if(sub==='competency'){
    body=`<div class="thr117-grid thr117-kpis">${kpi('Competencies',comps.length,'catalogue')}${kpi('Assessments',ec.length,'employee records')}${kpi('Verified Certificates',certs.filter(c=>c.verified).length,'supporting evidence')}${kpi('Expiring ≤30d',certs.filter(c=>c.days_to_expiry!=null&&c.days_to_expiry>=0&&c.days_to_expiry<=30).length,'renewal attention')}</div><div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Competency catalogue</h2><div><button class="thr117-btn" data-action="new-competency">New Competency</button><button class="thr117-btn primary" data-action="new-assessment">Record Assessment</button></div></div>${comps.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Code</th><th>Competency</th><th>Category</th><th>Status</th></tr></thead><tbody>${comps.map(c=>`<tr><td>${esc(c.code)}</td><td><b>${esc(c.label)}</b><div class="thr117-sub">${esc(c.description||'')}</div></td><td>${esc(c.category||'—')}</td><td>${tag(c.active?'Active':'Inactive',c.active?'ok':'')}</td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">No competency catalogue yet.</div>'}</div><div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Employee assessments</h2></div>${ec.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Employee</th><th>Competency</th><th>Level</th><th>Source</th><th>Date</th></tr></thead><tbody>${ec.map(x=>`<tr><td>${esc(x.employee_code)} · ${esc(x.employee_name)}</td><td>${esc(x.competency_label)}</td><td><b>${esc(x.level)}</b></td><td>${esc(x.source)}</td><td>${fmtDate(x.assessed_on)}</td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">No assessments yet.</div>'}</div>`;
  } else if(sub==='training'){
    body=`<div class="thr117-grid thr117-kpis">${kpi('Courses',courses.length,'catalogue')}${kpi('Enrollments',enroll.length,'training records')}${kpi('Completed',enroll.filter(x=>x.status==='completed').length,'completed sessions')}${kpi('Certificates',certs.length,'employee certificates')}</div><div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Training catalogue</h2><div><button class="thr117-btn" data-action="new-course">New Course</button><button class="thr117-btn primary" data-action="new-enrollment">Enroll Employee</button></div></div>${courses.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Code</th><th>Course</th><th>Provider</th><th>Mode</th><th>HRD Corp</th></tr></thead><tbody>${courses.map(c=>`<tr><td>${esc(c.code)}</td><td><b>${esc(c.title)}</b><div class="thr117-sub">${c.duration_hours??'—'} hr · ${c.default_cost!=null?money(c.default_cost):'cost not set'}</div></td><td>${esc(c.provider_name||'—')}</td><td>${esc(c.delivery_mode)}</td><td>${c.hrdcorp_claimable===true?tag('Claimable','ok'):c.hrdcorp_claimable===false?tag('Not claimable',''):tag('Not reviewed','warn')}</td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">No training courses yet.</div>'}</div><div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Enrollments</h2><button class="thr117-btn" data-action="new-certificate">Add Certificate</button></div>${enroll.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Employee</th><th>Course</th><th>Session</th><th>Status</th><th>Action</th></tr></thead><tbody>${enroll.map(e=>`<tr><td>${esc(e.employee_code)} · ${esc(e.employee_name)}</td><td>${esc(e.course_title)}</td><td>${fmtDate(e.session_start)} → ${fmtDate(e.session_end)}</td><td>${tag(e.status,e.status==='completed'?'ok':e.status==='failed'?'bad':'warn')}</td><td><button class="thr117-btn" data-action="edit-enrollment" data-id="${esc(e.id)}">Update</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">No enrollments yet.</div>'}</div><div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Certificates & expiry</h2><button class="thr117-btn" data-action="refresh-talent-alerts">Refresh Expiry Alerts</button></div>${certs.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Employee</th><th>Certificate</th><th>Issuer</th><th>Expiry</th><th>Verification</th></tr></thead><tbody>${certs.map(c=>`<tr><td>${esc(c.employee_code)} · ${esc(c.employee_name)}</td><td>${esc(c.certificate_name)}</td><td>${esc(c.issuer||'—')}</td><td>${fmtDate(c.expiry_date)} ${c.days_to_expiry!=null&&c.days_to_expiry<=30?tag(`${c.days_to_expiry}d`,'warn'):''}</td><td>${tag(c.verified?'Verified':'Unverified',c.verified?'ok':'warn')}</td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">No certificates yet.</div>'}</div>`;
  } else {
    body=`<div class="thr117-grid thr117-kpis">${kpi('Cycles',cycles.length,'performance cycles')}${kpi('Goals',goals.length,'employee goals')}${kpi('Reviews',reviews.length,'submitted reviews')}${kpi('Open Cycles',cycles.filter(c=>['open','calibration'].includes(c.status)).length,'active review cycles')}</div><div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Performance cycles</h2><div><button class="thr117-btn" data-action="new-cycle">New Cycle</button><button class="thr117-btn" data-action="new-goal">New Goal</button><button class="thr117-btn primary" data-action="new-review">Submit Review</button></div></div>${cycles.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Cycle</th><th>Period</th><th>Model</th><th>Goals</th><th>Reviews</th><th>Status</th></tr></thead><tbody>${cycles.map(c=>`<tr><td><b>${esc(c.name)}</b></td><td>${fmtDate(c.cycle_start)} → ${fmtDate(c.cycle_end)}</td><td>${esc(c.review_model)}</td><td>${esc(c.goal_count)}</td><td>${esc(c.review_count)}</td><td>${tag(c.status,['open','calibration'].includes(c.status)?'warn':c.status==='closed'?'ok':'')}</td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-empty">No performance cycles yet.</div>'}</div><div class="thr117-grid thr117-two thr117-section"><div class="thr117-card"><div class="thr117-section-title"><h2>Goals</h2></div><div class="thr117-list">${goals.length?goals.slice(0,40).map(g=>`<div class="thr117-list-item"><div><div class="thr117-name">${esc(g.employee_name)} · ${esc(g.title)}</div><div class="thr117-sub">${esc(g.cycle_name)} · ${g.weight}% · ${esc(g.status)}</div></div></div>`).join(''):'<div class="thr117-empty">No goals.</div>'}</div></div><div class="thr117-card"><div class="thr117-section-title"><h2>Reviews</h2></div><div class="thr117-list">${reviews.length?reviews.slice(0,40).map(r=>`<div class="thr117-list-item"><div><div class="thr117-name">${esc(r.employee_name)} · ${esc(r.reviewer_type)}</div><div class="thr117-sub">${esc(r.cycle_name)} · rating ${esc(r.calibrated_rating??r.overall_rating??'—')}</div></div>${r.status==='submitted'?`<button class="thr117-btn" data-action="calibrate-review" data-id="${esc(r.id)}">Calibrate</button>`:''}</div>`).join(''):'<div class="thr117-empty">No reviews.</div>'}</div></div></div>`;
  }
  return `${head('HUMAN CAPITAL','Talent','Performance, competency, training and certificate lifecycle.',actions)}${body}`;
}

function securityBlock(){
  const s=state.securityPosture||{},db=obj(s.database),rpcS=obj(s.rpc_surface),storage=obj(s.storage),ret=state.retentionBundle||{},settings=arr(ret.settings);
  const manual=arr(s.manual_checks);
  return `<div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Security posture</h2>${s.version?tag(s.version,'ok'):tag('Owner/Admin view')}</div>${s.version?`<div class="thr117-grid thr117-three"><div><div class="thr117-sub">Tables without RLS</div><div class="thr117-name">${esc(db.tables_without_rls??'—')}</div></div><div><div class="thr117-sub">Unexpected anon RPCs</div><div class="thr117-name">${arr(rpcS.unexpected_anon_endpoints).length}</div></div><div><div class="thr117-sub">Direct authenticated table grants</div><div class="thr117-name">${esc(db.authenticated_direct_table_grants??'—')}</div></div></div><div class="thr117-list" style="margin-top:12px">${manual.map(x=>`<div class="thr117-list-item"><div>${tag('Manual control','warn')} <span class="thr117-sub">${esc(x)}</span></div></div>`).join('')}</div>`:'<div class="thr117-sub">Security posture details are restricted to owner/admin.</div>'}</div>
  <div class="thr117-card thr117-section"><div class="thr117-section-title"><h2>Document retention</h2><span class="thr117-sub">No documents are deleted by this TRUST release.</span></div>${settings.length?`<div class="thr117-table-wrap"><table class="thr117-table"><thead><tr><th>Category</th><th>Retention</th><th>Status</th><th>Action</th></tr></thead><tbody>${settings.map(r=>`<tr><td>${esc(r.category.replaceAll('_',' '))}</td><td>${r.retention_days?`${esc(r.retention_days)} days`:'Not configured'}</td><td>${r.retention_days?tag('Configured','ok'):tag('Review','warn')}</td><td><button class="thr117-btn" data-action="retention-edit" data-key="${esc(r.category)}">Set Policy</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="thr117-sub">Retention settings are restricted to HR administrators.</div>'}</div>`;
}

function genericTableRows(rows){return arr(rows).map(r=>obj(r));}
function xmlEscape(v){return String(v??'').replace(/[<>&"']/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&apos;'}[c]));}
function colLetters(n){let s='';while(n>0){n--;s=String.fromCharCode(65+n%26)+s;n=Math.floor(n/26);}return s;}
function crc32(bytes){let c=0xffffffff;for(const b of bytes){c^=b;for(let k=0;k<8;k++)c=(c>>>1)^((c&1)?0xedb88320:0);}return (c^0xffffffff)>>>0;}
function le16(n){return [n&255,(n>>>8)&255];}
function le32(n){return [n&255,(n>>>8)&255,(n>>>16)&255,(n>>>24)&255];}
function zipStore(files){
  const enc=new TextEncoder(),locals=[],centrals=[];let offset=0;
  for(const f of files){const name=enc.encode(f.name),data=typeof f.data==='string'?enc.encode(f.data):f.data,crc=crc32(data);const local=new Uint8Array([...le32(0x04034b50),...le16(20),...le16(0),...le16(0),...le16(0),...le16(0),...le32(crc),...le32(data.length),...le32(data.length),...le16(name.length),...le16(0),...name,...data]);locals.push(local);const central=new Uint8Array([...le32(0x02014b50),...le16(20),...le16(20),...le16(0),...le16(0),...le16(0),...le16(0),...le32(crc),...le32(data.length),...le32(data.length),...le16(name.length),...le16(0),...le16(0),...le16(0),...le16(0),...le32(0),...le32(offset),...name]);centrals.push(central);offset+=local.length;}
  const centralSize=centrals.reduce((a,x)=>a+x.length,0),end=new Uint8Array([...le32(0x06054b50),...le16(0),...le16(0),...le16(files.length),...le16(files.length),...le32(centralSize),...le32(offset),...le16(0)]);return new Blob([...locals,...centrals,end],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
}
function xlsxBlob(rows,sheetName='Report'){
  rows=genericTableRows(rows);const cols=reportCols(rows);const matrix=[cols,...rows.map(r=>cols.map(c=>r[c]??''))];
  const sheetRows=matrix.map((row,ri)=>`<row r="${ri+1}">${row.map((v,ci)=>{const ref=`${colLetters(ci+1)}${ri+1}`;if(typeof v==='number'&&Number.isFinite(v))return `<c r="${ref}"><v>${v}</v></c>`;return `<c r="${ref}" t="inlineStr"><is><t>${xmlEscape(v)}</t></is></c>`;}).join('')}</row>`).join('');
  const files=[
    {name:'[Content_Types].xml',data:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/></Types>'},
    {name:'_rels/.rels',data:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>'},
    {name:'xl/workbook.xml',data:`<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets><sheet name="${xmlEscape(sheetName.slice(0,31))}" sheetId="1" r:id="rId1"/></sheets></workbook>`},
    {name:'xl/_rels/workbook.xml.rels',data:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/></Relationships>'},
    {name:'xl/worksheets/sheet1.xml',data:`<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData>${sheetRows}</sheetData></worksheet>`}
  ];return zipStore(files);
}
function pdfBlob(title,rows){
  const cols=reportCols(rows).slice(0,8);const lines=[title,`${state.reportStart} to ${state.reportEnd}`,'',cols.join(' | '),'-'.repeat(110),...rows.map(r=>cols.map(c=>String(r[c]??'').replace(/[\r\n]+/g,' ')).join(' | '))];
  const chunks=[];for(let i=0;i<lines.length;i+=48)chunks.push(lines.slice(i,i+48));const objs=[];const pageIds=[],contentIds=[];let next=3;chunks.forEach(()=>{pageIds.push(next++);contentIds.push(next++);});const fontId=next++;
  objs[1]='<< /Type /Catalog /Pages 2 0 R >>';objs[2]=`<< /Type /Pages /Kids [${pageIds.map(x=>`${x} 0 R`).join(' ')}] /Count ${pageIds.length} >>`;
  chunks.forEach((pg,idx)=>{const stream=`BT\n/F1 8 Tf\n36 806 Td\n${pg.map((l,i)=>`${i?'0 -15 Td\n':''}(${String(l).replace(/[^\x20-\x7E]/g,'?').replace(/([\\()])/g,'\\$1').slice(0,150)}) Tj`).join('\n')}\nET`;objs[pageIds[idx]]=`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 ${fontId} 0 R >> >> /Contents ${contentIds[idx]} 0 R >>`;objs[contentIds[idx]]=`<< /Length ${new TextEncoder().encode(stream).length} >>\nstream\n${stream}\nendstream`;});objs[fontId]='<< /Type /Font /Subtype /Type1 /BaseFont /Courier >>';
  let pdf='%PDF-1.4\n',offsets=[0];for(let i=1;i<objs.length;i++){offsets[i]=new TextEncoder().encode(pdf).length;pdf+=`${i} 0 obj\n${objs[i]}\nendobj\n`;}const xref=new TextEncoder().encode(pdf).length;pdf+=`xref\n0 ${objs.length}\n0000000000 65535 f \n`;for(let i=1;i<objs.length;i++)pdf+=`${String(offsets[i]).padStart(10,'0')} 00000 n \n`;pdf+=`trailer\n<< /Size ${objs.length} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF`;return new Blob([pdf],{type:'application/pdf'});
}

async function exportCurrentReport(format){
  const rows=reportRows();if(!rows.length){toast('Run a report first.');return;}const key=state.reportKey||'report';let blob,name;
  if(format==='csv'){const cols=reportCols(rows),cell=v=>`"${String(v??'').replace(/"/g,'""')}"`,text=[cols.map(cell).join(','),...rows.map(r=>cols.map(c=>cell(r[c])).join(','))].join('\n');blob=new Blob([text],{type:'text/csv;charset=utf-8'});name=`trust-${key}-${todayISO()}.csv`;}
  else if(format==='xlsx'){blob=xlsxBlob(rows,key);name=`trust-${key}-${todayISO()}.xlsx`;}
  else {blob=pdfBlob(`TRUST ${key.toUpperCase()} REPORT`,rows);name=`trust-${key}-${todayISO()}.pdf`;}
  const buf=await blob.arrayBuffer(),hash=await sha256Buffer(buf);downloadBlob(name,blob);
  await safe(rpc('thr_log_report_export_v121',{p_org_id:ORG_ID,p_report_key:key,p_export_format:format,p_filters:{start:state.reportStart,end:state.reportEnd},p_row_count:rows.length,p_content_hash:hash||null}),null);
  toast(`${format.toUpperCase()} report exported and audit logged.`);
}

function normalizeHeader(s){return String(s??'').toLowerCase().replace(/[^a-z0-9]+/g,'').trim();}
function parseCSVText(text){const rows=[];let row=[],cell='',q=false;for(let i=0;i<text.length;i++){const c=text[i],n=text[i+1];if(q){if(c==='"'&&n==='"'){cell+='"';i++;}else if(c==='"')q=false;else cell+=c;}else{if(c==='"')q=true;else if(c===','){row.push(cell);cell='';}else if(c==='\n'){row.push(cell.replace(/\r$/,''));rows.push(row);row=[];cell='';}else cell+=c;}}if(cell.length||row.length){row.push(cell.replace(/\r$/,''));rows.push(row);}return rows.filter(r=>r.some(x=>String(x).trim()!==''));}
async function inflateRaw(bytes){const ds=new DecompressionStream('deflate-raw');return new Uint8Array(await new Response(new Blob([bytes]).stream().pipeThrough(ds)).arrayBuffer());}
function dvU16(dv,o){return dv.getUint16(o,true);}function dvU32(dv,o){return dv.getUint32(o,true);}
async function unzipXlsx(buffer){const bytes=new Uint8Array(buffer),dv=new DataView(buffer);let eocd=-1;for(let i=bytes.length-22;i>=Math.max(0,bytes.length-65557);i--){if(dvU32(dv,i)===0x06054b50){eocd=i;break;}}if(eocd<0)throw new Error('Invalid XLSX ZIP container.');const total=dvU16(dv,eocd+10),centralOff=dvU32(dv,eocd+16),out={};let p=centralOff;const dec=new TextDecoder();for(let i=0;i<total;i++){if(dvU32(dv,p)!==0x02014b50)throw new Error('Invalid XLSX central directory.');const method=dvU16(dv,p+10),comp=dvU32(dv,p+20),nameLen=dvU16(dv,p+28),extra=dvU16(dv,p+30),comment=dvU16(dv,p+32),local=dvU32(dv,p+42),name=dec.decode(bytes.slice(p+46,p+46+nameLen))